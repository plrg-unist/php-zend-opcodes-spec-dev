;; Untouched entries belong to the same original CLI array and compare equal.
;; Only changed keys can affect the element count or the first difference.
syntax serverComparison = { MODE comparisonMode, LEFT slotValue, RIGHT slotValue, KEYS arraykey* }
syntax serverField = FIELD slotValue? | HOST_FIELD nat hostSource
syntax serverPair = FIELDS serverField serverField

dec $except_keys(arraykey*, arraykey*) : arraykey*
def $except_keys(eps, _) = eps
def $except_keys(arraykey :: arraykey_rest*, arraykey_excluded*) = $except_keys(arraykey_rest*, arraykey_excluded*)
  -- if arraykey <- arraykey_excluded*
def $except_keys(arraykey :: arraykey_rest*, arraykey_excluded*) = arraykey :: $except_keys(arraykey_rest*, arraykey_excluded*)
  -- if ~(arraykey <- arraykey_excluded*)

;; A conditional tail entry stays at its original position if supplied by the host.
dec $actual_tail(runtimeEntry*, arraykey*) : arraykey*
def $actual_tail(eps, _) = eps
def $actual_tail((ITEM arraykey slotValue) :: runtimeEntry*, arraykey_present*) = arraykey :: $actual_tail(runtimeEntry*, arraykey_present*)
  -- if slotValue = TRUE \/ ~(arraykey <- arraykey_present*)
def $actual_tail((ITEM arraykey FALSE) :: runtimeEntry*, arraykey_present*) = $actual_tail(runtimeEntry*, arraykey_present*)
  -- if arraykey <- arraykey_present*

dec $inherited_field(hostSource, arraykey*) : serverField
def $inherited_field(CLOCK_ENTRY arraykey, _) = HOST_FIELD $scalar_type_bit(slotValue) (CLOCK_ENTRY arraykey)
  -- if [slotValue] = $host_type_values(HOST_OFFSET (CLOCK_ENTRY arraykey))
def $inherited_field(ENV_ENTRY arraykey, arraykey_present*) = HOST_FIELD 64 (ENV_ENTRY arraykey)
  -- if arraykey <- arraykey_present*
def $inherited_field(_, _) = FIELD NULL -- otherwise

dec $server_field(comparisonMode, serverLookup, arraykey, arraykey*) : serverField
def $server_field(comparisonMode, SERVER_KNOWN slotValue, _, arraykey_present*) = $inherited_field(hostSource, arraykey_present*)
  -- if HOST_OFFSET hostSource = $compare_deref(comparisonMode, slotValue)
def $server_field(comparisonMode, SERVER_KNOWN slotValue, _, _) = FIELD slotValue_v
  -- if slotValue_v = $compare_deref(comparisonMode, slotValue)
  -- if ~$host_offset(slotValue_v)
def $server_field(_, SERVER_KNOWN eps, _, _) = FIELD eps
def $server_field(_, SERVER_UNKNOWN, arraykey, arraykey_present*) = FIELD eps -- if ~(arraykey <- arraykey_present*)
def $server_field(_, serverLookup, arraykey, arraykey_present*) = $inherited_field($host_source(serverLookup, arraykey), arraykey_present*)
  -- if serverLookup = SERVER_PRESENT \/ (serverLookup = SERVER_UNKNOWN /\ (arraykey <- arraykey_present*))
def $server_field(_, SERVER_CAPTURED hostSource, _, arraykey_present*) = $inherited_field(hostSource, arraykey_present*)

dec $server_fields(serverComparison, arraykey*, arraykey) : serverPair
def $server_fields(serverComparison, arraykey_present*, arraykey) =
  FIELDS ($server_field(comparisonMode, $server_entry(serverComparison.LEFT, arraykey, bytes), arraykey, arraykey_present*))
         ($server_field(comparisonMode, $server_entry(serverComparison.RIGHT, arraykey, bytes), arraykey, arraykey_present*))
  -- if comparisonMode = serverComparison.MODE
  -- if bytes = comparisonMode.SCRIPT

dec $count_difference(serverPair*) : int
def $count_difference(eps) = 0
def $count_difference((FIELDS serverField_l serverField_r) :: serverPair*) =
  $($bool_order(serverField_l =/= FIELD eps, serverField_r =/= FIELD eps) + $count_difference(serverPair*))

;; An inherited host entry is either a string or a numeric clock entry.
dec $field_order(comparisonMode, serverPair) : valueOrder
def $field_order(_, FIELDS (FIELD eps) _) = ORDER 0
def $field_order(_, FIELDS serverField (FIELD eps)) = ORDER 1 -- if serverField =/= FIELD eps
def $field_order(comparisonMode, FIELDS (FIELD slotValue_l) (FIELD slotValue_r)) = $value_order(comparisonMode, slotValue_l, slotValue_r)
def $field_order(comparisonMode, FIELDS (FIELD slotValue) (HOST_FIELD n _)) = $typed_host_order(comparisonMode, [n], slotValue, 1)
def $field_order(comparisonMode, FIELDS (HOST_FIELD n _) (FIELD slotValue)) = $typed_host_order(comparisonMode, [n], slotValue, -1)
def $field_order(_, FIELDS (HOST_FIELD n hostSource) (HOST_FIELD n hostSource)) = ORDER 0
def $field_order(comparisonMode, FIELDS (HOST_FIELD n_l _) (HOST_FIELD n_r _)) = ORDER 1
  -- if comparisonMode.STRICT /\ n_l =/= n_r
def $field_order(_, _) = UNKNOWN_ORDER -- otherwise

dec $server_equal(valueOrder*) : valueOrder
def $server_equal(valueOrder*) = ORDER 1 -- if (ORDER 1 <- valueOrder*) \/ (ORDER (-1) <- valueOrder*)
def $server_equal(valueOrder*) = UNKNOWN_ORDER
  -- if ~(ORDER 1 <- valueOrder*) /\ ~(ORDER (-1) <- valueOrder*) /\ (UNKNOWN_ORDER <- valueOrder*)
def $server_equal(_) = ORDER 0 -- otherwise

;; Each resulting array consists of the surviving original keys followed by its
;; tail. If the tails differ, equality is possible only when one is a suffix
;; of the other: the extra keys would have to end the surviving original order.
dec $suffix(arraykey*, arraykey*) : bool
def $suffix(arraykey_l*, arraykey_r*) = arraykey_l* = arraykey_r*[n : |arraykey_l*|]
  -- if $(|arraykey_l*| <= |arraykey_r*|)
  -- if n = $(|arraykey_r*| - |arraykey_l*|)
def $suffix(_, _) = false -- otherwise

dec $tail_equality(bool, arraykey*, arraykey*) : valueOrder
def $tail_equality(false, _, _) = ORDER 0
def $tail_equality(true, arraykey*, arraykey*) = ORDER 0
def $tail_equality(true, arraykey_l*, arraykey_r*) = UNKNOWN_ORDER
  -- if arraykey_l* =/= arraykey_r*
  -- if $suffix(arraykey_l*, arraykey_r*) \/ $suffix(arraykey_r*, arraykey_l*)
def $tail_equality(_, _, _) = ORDER 1 -- otherwise

dec $first_order(valueOrder*) : valueOrder
def $first_order(eps) = ORDER 0
def $first_order((ORDER 0) :: valueOrder*) = $first_order(valueOrder*)
def $first_order(valueOrder :: valueOrder_rest*) = $unknown_before(valueOrder, $first_order(valueOrder_rest*))
  -- if valueOrder <- [UNKNOWN_ORDER, POSSIBLE_RECURSION true]
def $first_order(valueOrder :: _) = valueOrder -- if ~$may_equal(valueOrder)

;; The host can arrange original keys in either order. A single direction of
;; change therefore determines the result even when the original order is unknown.
dec $original_order(valueOrder*) : valueOrder
def $original_order(valueOrder*) = $first_order(valueOrder*)
  -- if valueOrder_first = $first_order(valueOrder*)
  -- if ~(false <- (valueOrder = ORDER 0 \/ valueOrder = valueOrder_first)*)
def $original_order(valueOrder*) = POSSIBLE_RECURSION (~(false <- ($may_equal(valueOrder))*))
  -- if valueOrder_first = $first_order(valueOrder*)
  -- if false <- (valueOrder = ORDER 0 \/ valueOrder = valueOrder_first)*
  -- if true <- ($may_recurse(valueOrder))*
def $original_order(_) = UNKNOWN_ORDER -- otherwise

dec $server_at(serverComparison, arraykey*, arraykey) : valueOrder
def $server_at(serverComparison, arraykey_present*, arraykey) =
  $field_order(serverComparison.MODE, $server_fields(serverComparison, arraykey_present*, arraykey))

syntax equalChoices = { SAME bool, DIFFER bool, RECURSE bool }
dec $equal_choices(valueOrder) : equalChoices
def $equal_choices(valueOrder) =
  { SAME $may_equal(valueOrder), DIFFER (~(valueOrder <- [ORDER 0, RECURSIVE_ORDER])), RECURSE $may_recurse(valueOrder) }

dec $unordered_equal(valueOrder*) : equalChoices
def $unordered_equal(valueOrder*) =
  { SAME (~(false <- (equalChoices.SAME)*)), DIFFER (true <- (equalChoices.DIFFER)*), RECURSE (true <- (equalChoices.RECURSE)*) }
  -- if (equalChoices = $equal_choices(valueOrder))*

dec $then_equal(equalChoices, equalChoices) : equalChoices
def $then_equal(equalChoices_a, equalChoices_b) =
  { SAME (equalChoices_a.SAME /\ equalChoices_b.SAME), DIFFER (equalChoices_a.DIFFER \/ (equalChoices_a.SAME /\ equalChoices_b.DIFFER)),
    RECURSE (equalChoices_a.RECURSE \/ (equalChoices_a.SAME /\ equalChoices_b.RECURSE)) }

dec $choices_order(equalChoices) : valueOrder
def $choices_order({ SAME false, DIFFER true, RECURSE false }) = ORDER 1
def $choices_order({ SAME false, DIFFER false, RECURSE true }) = RECURSIVE_ORDER
def $choices_order({ SAME b, DIFFER true, RECURSE true }) = POSSIBLE_RECURSION b

dec $ordered_equal(valueOrder*) : equalChoices
def $ordered_equal(eps) = $equal_choices(ORDER 0)
def $ordered_equal(valueOrder :: valueOrder_rest*) = $then_equal($equal_choices(valueOrder), $ordered_equal(valueOrder_rest*))

;; An original key on only one side can mismatch an intervening unmodified
;; host key. To reach the tail, all shared originals have to align first.
dec $align_tail(serverComparison, arraykey*, arraykey*, arraykey*, arraykey*) : equalChoices
def $align_tail(serverComparison, arraykey_present*, arraykey :: arraykey_tail*, arraykey_extra*, arraykey_short*) =
  $then_equal($equal_choices($server_at(serverComparison, arraykey_present*, arraykey)),
              $align_tail(serverComparison, arraykey_present*, arraykey_tail*, $except_keys(arraykey_extra*, [arraykey]), arraykey_short*))
  -- if arraykey <- arraykey_extra*
def $align_tail(serverComparison, arraykey_present*, arraykey :: arraykey_tail*, eps, arraykey :: arraykey_short*) =
  $then_equal($equal_choices($server_at(serverComparison, arraykey_present*, arraykey)),
              $align_tail(serverComparison, arraykey_present*, arraykey_tail*, eps, arraykey_short*))
def $align_tail(_, _, eps, eps, eps) = $equal_choices(ORDER 0)
def $align_tail(_, _, _, _, _) = { SAME false, DIFFER true, RECURSE false } -- otherwise

dec $strict_rest(serverComparison, arraykey*, arraykey*, arraykey*, arraykey*, arraykey*) : equalChoices
def $strict_rest(serverComparison, arraykey_present*, arraykey_l*, arraykey_r*, arraykey_exl*, eps) =
  $align_tail(serverComparison, arraykey_present*, arraykey_r*, arraykey_exl*, arraykey_l*)
def $strict_rest(serverComparison, arraykey_present*, arraykey_l*, arraykey_r*, eps, arraykey_exr*) =
  $align_tail(serverComparison, arraykey_present*, arraykey_l*, arraykey_exr*, arraykey_r*)
  -- if arraykey_exr* =/= eps
def $strict_rest(_, _, _, _, arraykey_exl*, arraykey_exr*) = { SAME false, DIFFER true, RECURSE false }
  -- if arraykey_exl* =/= eps /\ arraykey_exr* =/= eps

dec $base_keys(serverComparison, arraykey*, arraykey*, slotValue) : arraykey*
def $base_keys(_, _, eps, _) = eps
def $base_keys(serverComparison, arraykey_present*, arraykey :: arraykey_rest*, slotValue) = arraykey :: $base_keys(serverComparison, arraykey_present*, arraykey_rest*, slotValue)
  -- if $server_field(serverComparison.MODE, $server_entry(slotValue, arraykey, serverComparison.MODE.SCRIPT), arraykey, arraykey_present*) =/= FIELD eps
def $base_keys(serverComparison, arraykey_present*, arraykey :: arraykey_rest*, slotValue) = $base_keys(serverComparison, arraykey_present*, arraykey_rest*, slotValue)
  -- if $server_field(serverComparison.MODE, $server_entry(slotValue, arraykey, serverComparison.MODE.SCRIPT), arraykey, arraykey_present*) = FIELD eps

dec $recursive_equality(serverComparison, arraykey*, arraykey*, arraykey*) : valueOrder
def $recursive_equality(serverComparison, arraykey_present*, arraykey_tail*, _) =
  $choices_order($then_equal($unordered_equal(valueOrder_base*), $ordered_equal(valueOrder_tail*)))
  -- if ~serverComparison.MODE.STRICT
  -- if arraykey_base* = $except_keys(serverComparison.KEYS, arraykey_tail*)
  -- if valueOrder_base* = ($server_at(serverComparison, arraykey_present*, arraykey_base))*
  -- if valueOrder_tail* = ($server_at(serverComparison, arraykey_present*, arraykey_tail))*
def $recursive_equality(serverComparison, arraykey_present*, arraykey_l*, arraykey_r*) =
  $choices_order($then_equal(equalChoices_base[.DIFFER = (equalChoices_base.DIFFER \/ arraykey_exl* =/= eps \/ arraykey_exr* =/= eps)],
                             $strict_rest(serverComparison, arraykey_present*, arraykey_l*, arraykey_r*, arraykey_exl*, arraykey_exr*)))
  -- if serverComparison.MODE.STRICT
  -- if arraykey_bl* = $base_keys(serverComparison, arraykey_present*, $except_keys(serverComparison.KEYS, arraykey_l*), serverComparison.LEFT)
  -- if arraykey_br* = $base_keys(serverComparison, arraykey_present*, $except_keys(serverComparison.KEYS, arraykey_r*), serverComparison.RIGHT)
  -- if arraykey_exl* = $except_keys(arraykey_bl*, arraykey_br*)
  -- if arraykey_exr* = $except_keys(arraykey_br*, arraykey_bl*)
  -- if arraykey_common* = $except_keys(arraykey_bl*, arraykey_exl*)
  -- if equalChoices_base = $unordered_equal(($server_at(serverComparison, arraykey_present*, arraykey_common))*)

dec $equal_server_result(serverComparison, arraykey*, arraykey*, arraykey*, valueOrder*) : valueOrder
def $equal_server_result(serverComparison, arraykey_present*, arraykey_l*, arraykey_r*, valueOrder*) =
  $recursive_equality(serverComparison, arraykey_present*, arraykey_l*, arraykey_r*)
  -- if true <- ($may_recurse(valueOrder))*
def $equal_server_result(serverComparison, _, arraykey_l*, arraykey_r*, valueOrder*) =
  $server_equal($tail_equality(serverComparison.MODE.STRICT, arraykey_l*, arraykey_r*) :: valueOrder*)
  -- if ~(true <- ($may_recurse(valueOrder))*)

dec $server_by_size(serverComparison, arraykey*, int) : valueOrder
def $server_by_size(serverComparison, _, i) = ORDER 1 -- if i =/= 0 /\ serverComparison.MODE.EQUALITY
def $server_by_size(serverComparison, _, i) = ORDER $int_order(i, 0) -- if i =/= 0 /\ ~serverComparison.MODE.EQUALITY
def $server_by_size(serverComparison, arraykey_present*, 0) =
  $equal_server_result(serverComparison, arraykey_present*, arraykey_l*, arraykey_r*, valueOrder*)
  -- if serverComparison.MODE.EQUALITY
  -- if arraykey_l* = $actual_tail($server_order(serverComparison.LEFT), arraykey_present*)
  -- if arraykey_r* = $actual_tail($server_order(serverComparison.RIGHT), arraykey_present*)
  -- if arraykey* = serverComparison.KEYS
  -- if valueOrder* = ($server_at(serverComparison, arraykey_present*, arraykey))*
def $server_by_size(serverComparison, arraykey_present*, 0) =
  $first_order($original_order(valueOrder_base*) :: valueOrder_tail*)
  -- if ~serverComparison.MODE.EQUALITY
  -- if arraykey_tail* = $actual_tail($server_order(serverComparison.LEFT), arraykey_present*)
  -- if arraykey_base* = $except_keys(serverComparison.KEYS, arraykey_tail*)
  -- if valueOrder_base* = ($server_at(serverComparison, arraykey_present*, arraykey_base))*
  -- if valueOrder_tail* = ($server_at(serverComparison, arraykey_present*, arraykey_tail))*

dec $agreed_order(valueOrder, valueOrder) : valueOrder
def $agreed_order(valueOrder, valueOrder) = valueOrder
def $agreed_order(valueOrder_l, valueOrder_r) = POSSIBLE_RECURSION ($may_equal(valueOrder_l) \/ $may_equal(valueOrder_r))
  -- if valueOrder_l =/= valueOrder_r /\ ($may_recurse(valueOrder_l) \/ $may_recurse(valueOrder_r))
def $agreed_order(_, _) = UNKNOWN_ORDER -- otherwise

;; An entry with the same overridden value cannot be the first difference in
;; a loose comparison. Its original position can still affect strict ordering.
dec $field_origin(slotValue) : arraykey*
def $field_origin(HOST_OFFSET (ENV_ENTRY arraykey)) = [arraykey]
def $field_origin(_) = eps -- otherwise

dec $host_origins(comparisonMode, runtimeEntry*) : arraykey*
def $host_origins(_, eps) = eps
def $host_origins(comparisonMode, (ITEM _ slotValue) :: runtimeEntry*) =
  $field_origin($compare_deref(comparisonMode, slotValue)) ++ $host_origins(comparisonMode, runtimeEntry*)

dec $presence_matters(serverComparison, arraykey) : bool
def $presence_matters(serverComparison, arraykey) =
  (arraykey <- $host_origins(serverComparison.MODE, $server_changes(serverComparison.LEFT) ++ $server_changes(serverComparison.RIGHT))) \/
  (($server_lookup($server_origin(serverComparison.LEFT), arraykey, eps) = SERVER_UNKNOWN) /\
    (($server_at(serverComparison, eps, arraykey) =/= ORDER 0) \/
     (serverComparison.MODE.STRICT /\ $server_order(serverComparison.LEFT) =/= $server_order(serverComparison.RIGHT)) \/
     ($array_find($server_changes(serverComparison.LEFT), arraykey) = eps) \/ ($array_find($server_changes(serverComparison.RIGHT), arraykey) = eps)))

dec $server_possibilities(serverComparison, arraykey*, arraykey*) : valueOrder
dec $also_present(serverComparison, arraykey*, arraykey*, valueOrder) : valueOrder
def $also_present(serverComparison, arraykey_rest*, arraykey_present*, valueOrder) =
  $agreed_order(valueOrder, $server_possibilities(serverComparison, arraykey_rest*, arraykey_present*))
def $server_possibilities(serverComparison, eps, arraykey_present*) =
  $server_by_size(serverComparison, arraykey_present*, $count_difference(serverPair*))
  -- if arraykey* = serverComparison.KEYS
  -- if serverPair* = ($server_fields(serverComparison, arraykey_present*, arraykey))*
def $server_possibilities(serverComparison, arraykey :: arraykey_rest*, arraykey_present*) =
  $also_present(serverComparison, arraykey_rest*, arraykey :: arraykey_present*,
                $server_possibilities(serverComparison, arraykey_rest*, arraykey_present*))
  -- if $presence_matters(serverComparison, arraykey)
def $server_possibilities(serverComparison, arraykey :: arraykey_rest*, arraykey_present*) =
  $server_possibilities(serverComparison, arraykey_rest*, arraykey_present*)
  -- if ~$presence_matters(serverComparison, arraykey)

dec $shared_server_order(comparisonMode, slotValue, slotValue) : valueOrder
def $shared_server_order(comparisonMode, slotValue_l, slotValue_r) =
  $server_possibilities(serverComparison, arraykey* ++ $except_keys(arraykey_origins*, arraykey*), eps)
  -- if arraykey_origins* = $host_origins(comparisonMode, $server_changes(slotValue_l) ++ $server_changes(slotValue_r))
  -- if (ITEM arraykey_l _)* = $server_changes(slotValue_l)
  -- if (ITEM arraykey_r _)* = $server_changes(slotValue_r)
  -- if arraykey* = arraykey_l* ++ $except_keys(arraykey_r*, arraykey_l*)
  -- if serverComparison = { MODE comparisonMode, LEFT slotValue_l, RIGHT slotValue_r, KEYS arraykey* }

def $server_pair_order(comparisonMode, slotValue_l, slotValue_r) =
  $shared_server_order(comparisonMode, $server_view(slotValue_l, slotValue_r, comparisonMode.SCRIPT),
                                       $server_view(slotValue_r, slotValue_l, comparisonMode.SCRIPT))

;; A missing key proves inequality at equal cardinality. Before that key Zend
;; may compare two nested arrays and raise a recursion error. Strict equality
;; visits keys positionally; loose equality follows the left operand's order.
syntax mixedKey = ABSENT_KEY | SAFE_KEY | UNCHECKED_KEY

dec $mixed_child_order(comparisonMode, slotValue, slotValue, bool) : valueOrder
def $mixed_child_order(comparisonMode, slotValue_host, slotValue_plain, true) = $value_order(comparisonMode, slotValue_plain, slotValue_host)
def $mixed_child_order(comparisonMode, slotValue_host, slotValue_plain, false) = $value_order(comparisonMode, slotValue_host, slotValue_plain)

dec $safe_mixed_entry(comparisonMode, serverLookup, slotValue, bool) : bool
def $safe_mixed_entry(comparisonMode, SERVER_KNOWN slotValue, slotValue_plain, b_plain_left) =
  $simple_value(slotValue_v) \/ $host_offset(slotValue_v) \/ ($is_array_value(slotValue_v) /\
    (~$is_array_value(slotValue_plain) \/ ~$may_recurse($mixed_child_order(comparisonMode, slotValue_v, slotValue_plain, b_plain_left))))
  -- if slotValue_v = $compare_deref(comparisonMode, slotValue)
def $safe_mixed_entry(_, _, _, _) = true -- otherwise

dec $mixed_key(comparisonMode, serverLookup, slotValue, bool) : mixedKey
def $mixed_key(_, SERVER_KNOWN eps, _, _) = ABSENT_KEY
def $mixed_key(comparisonMode, serverLookup, slotValue, b_plain_left) = SAFE_KEY
  -- if serverLookup =/= SERVER_KNOWN eps
  -- if slotValue_plain = $compare_deref(comparisonMode, slotValue)
  -- if ($known_value(slotValue_plain) \/ $host_offset(slotValue_plain)) /\ $safe_mixed_entry(comparisonMode, serverLookup, slotValue_plain, b_plain_left)
def $mixed_key(_, _, _, _) = UNCHECKED_KEY -- otherwise

dec $mixed_key_order(mixedKey*, bool) : valueOrder
def $mixed_key_order(eps, _) = UNKNOWN_ORDER
def $mixed_key_order(SAFE_KEY :: mixedKey*, b) = $mixed_key_order(mixedKey*, b)
def $mixed_key_order(ABSENT_KEY :: mixedKey*, b) = ORDER 1
  -- if b \/ ~(UNCHECKED_KEY <- mixedKey*)
def $mixed_key_order(ABSENT_KEY :: mixedKey*, false) = POSSIBLE_RECURSION false
  -- if UNCHECKED_KEY <- mixedKey*
def $mixed_key_order(UNCHECKED_KEY :: mixedKey*, _) = POSSIBLE_RECURSION (~(ABSENT_KEY <- mixedKey*))

def $mixed_equality(comparisonMode, slotValue, (ITEM arraykey slotValue_entry)*, b_plain_left) =
  $mixed_key_order(mixedKey*, comparisonMode.STRICT \/ b_plain_left)
  -- if mixedKey* = ($mixed_key(comparisonMode, $server_entry(slotValue, arraykey, comparisonMode.SCRIPT), slotValue_entry, b_plain_left))*
