var n : nat
var i : int
var b : bool

;; Shared arrays compare equal immediately, even when an element is NaN.
syntax literalRoot = POOL_LITERAL bytes nat | SHARED_LITERAL nat
syntax arrayId = LITERAL_ARRAY literalRoot arraykey* | FRESH_ARRAY nat | CLI_ARRAY_ID nat | SYMBOL_TABLE
syntax slotValue
syntax runtimeEntry = ITEM arraykey slotValue
syntax cliOrigin = SERVER | ENVIRONMENT
syntax hostSource = ENV_ENTRY arraykey | CLOCK_ENTRY arraykey
syntax serverHistory = { ORIGIN cliOrigin, TAIL runtimeEntry*, SATURATED bool }
syntax arrayLayout = VACANT nat | PACKED nat | MIXED nat nat*
;; The final storage field records whether the table is immutable.
syntax arrayIndex = STORAGE int arrayLayout bool
syntax slotValue = zval | CLI_ARRAY | CLI_ENV | CLI_UPDATED arrayId runtimeEntry* serverHistory | ARRAY_VALUE arrayId runtimeEntry* arrayIndex? nat?
                 | STREAM nat
                 | ELEMENT_LOCATION nat arraykey | SYMBOL_LOCATION bool nat | REFERENCE nat | HOST_OFFSET hostSource
syntax borrowedTable = TABLE arrayId slotValue

dec $current(borrowedTable*, slotValue) : slotValue
dec $cell_value(borrowedTable*, slotValue*, slotValue) : slotValue
dec $is_reference(slotValue) : bool
def $is_reference(REFERENCE _) = true
def $is_reference(_) = false -- otherwise

;; Conversions can emit several diagnostics before producing a value or raising an error.
syntax numericResult =
  | NUM_VALUE slotValue | NUM_ERROR bytes | NUM_WARNING bytes numericResult
  | NUM_DEPRECATED bytes numericResult | NUM_UNSUPPORTED

;; Single-bit masks in the TYPE_CHECK instruction's extended value.
dec $scalar_type_bit(slotValue) : nat
def $scalar_type_bit(NULL) = 2
def $scalar_type_bit(FALSE) = 4
def $scalar_type_bit(TRUE) = 8
def $scalar_type_bit(INT _) = 16
def $scalar_type_bit(FLOAT _) = 32
def $scalar_type_bit(STRING _) = 64
def $scalar_type_bit(STREAM _) = 512
def $scalar_type_bit(_) = 0
  -- otherwise

dec $simple_value(slotValue) : bool
def $simple_value(slotValue) = $scalar_type_bit(slotValue) =/= 0

dec $host_offset(slotValue) : bool
dec $host_type_values(slotValue) : slotValue*

dec $server_array(slotValue) : bool
def $server_array(CLI_ARRAY) = true
def $server_array(CLI_ENV) = true
def $server_array(CLI_UPDATED _ _ _) = true
def $server_array(_) = false -- otherwise

dec $server_min_size(slotValue) : nat
dec $server_id(slotValue) : arrayId

dec $truth_known(slotValue) : bool
def $truth_known(slotValue) = $($server_min_size(slotValue) > 0)
  -- if $server_array(slotValue)
def $truth_known(_) = true -- otherwise

dec $is_array_value(slotValue) : bool
def $is_array_value(ARRAY_VALUE _ _ _ _) = true
def $is_array_value(slotValue) = true -- if $server_array(slotValue)
def $is_array_value(_) = false
  -- otherwise

dec $known_value(slotValue) : bool
def $known_value(slotValue) = $simple_value(slotValue) \/ $is_array_value(slotValue)

dec $type_check(slotValue, nat) : bool
def $type_check(UNDEF, n_mask) = $(n_mask \ 2 = 1)
def $type_check(DEFERRED _, n_mask) = $((n_mask / 2048) \ 2 = 1)
def $type_check(REFERENCE _, n_mask) = $((n_mask / 1024) \ 2 = 1)
def $type_check(slotValue, n_mask) = $((n_mask / 128) \ 2 = 1)
  -- if $is_array_value(slotValue)
def $type_check(slotValue, n_mask) = $((n_mask / n_bit) \ 2 = 1)
  -- if n_bit = $scalar_type_bit(slotValue)
  -- if n_bit =/= 0

dec $gettype(slotValue) : bytes
def $gettype(NULL) = [ 78, 85, 76, 76 ]                            ;; NULL
def $gettype(slotValue) = [ 98, 111, 111, 108, 101, 97, 110 ]           ;; boolean
  -- if slotValue = TRUE \/ slotValue = FALSE
def $gettype(INT _) = [ 105, 110, 116, 101, 103, 101, 114 ]        ;; integer
def $gettype(FLOAT _) = [ 100, 111, 117, 98, 108, 101 ]            ;; double
def $gettype(STRING _) = [ 115, 116, 114, 105, 110, 103 ]          ;; string
def $gettype(STREAM _) = [ 114, 101, 115, 111, 117, 114, 99, 101 ] ;; resource
def $gettype(slotValue) = [ 97, 114, 114, 97, 121 ]               ;; array
  -- if $is_array_value(slotValue)
def $gettype(_) = [ 117, 110, 107, 110, 111, 119, 110, 32, 116, 121, 112, 101 ] ;; unknown type
  -- otherwise

;; Names used in PHP diagnostics. Boolean literals have distinct names.
dec $value_name(slotValue) : bytes
def $value_name(slotValue) = [ 110, 117, 108, 108 ]
  -- if slotValue = NULL \/ slotValue = UNDEF
def $value_name(TRUE) = [ 116, 114, 117, 101 ]
def $value_name(FALSE) = [ 102, 97, 108, 115, 101 ]
def $value_name(INT _) = [ 105, 110, 116 ]
def $value_name(FLOAT _) = [ 102, 108, 111, 97, 116 ]
def $value_name(STRING _) = [ 115, 116, 114, 105, 110, 103 ]
def $value_name(slotValue) = $gettype(slotValue)
  -- if $is_array_value(slotValue) \/ $scalar_type_bit(slotValue) = 512

dec $zend_bool(bool) : zval
def $zend_bool(true) = TRUE
def $zend_bool(false) = FALSE

;; Removing the sign bit gives the binary64 magnitude encoding.
dec $float_magnitude(nat) : nat
def $float_magnitude(n) = $(n \ 0x8000_0000_0000_0000)

dec $is_nan(slotValue) : bool
def $is_nan(FLOAT n) = $($float_magnitude(n) > 0x7FF0_0000_0000_0000)
def $is_nan(_) = false
  -- otherwise

dec $truth(slotValue) : bool
def $truth(UNDEF) = false
def $truth(DEFERRED _) = false
def $truth(NULL) = false
def $truth(FALSE) = false
def $truth(TRUE) = true
def $truth(STREAM _) = true
def $truth(INT i) = i =/= 0
def $truth(FLOAT n) = $float_magnitude(n) =/= 0
def $truth(STRING bytes) = (bytes =/= eps) /\ (bytes =/= [ 48 ])
def $truth(ARRAY_VALUE _ runtimeEntry* _ _) = runtimeEntry* =/= eps
def $truth(slotValue) = true -- if $server_array(slotValue) /\ $truth_known(slotValue)

;; Decimal PHP integers are emitted as ASCII octets.
dec $digits(nat) : bytes
def $digits(n) = [ $(48 + n) ]
  -- if $(n < 10)
def $digits(n) = $digits($(n / 10)) ++ [ $(48 + (n \ 10)) ]
  -- if $(n >= 10)

dec $decimal(int) : bytes
def $decimal(i) = $digits(n)
  -- if $(i >= 0)
  -- if n = i
def $decimal(i) = 45 :: $digits(n)
  -- if $(i < 0)
  -- if n = $(-i)

dec $scalar_bytes(slotValue) : bytes
def $scalar_bytes(STRING bytes) = bytes
def $scalar_bytes(INT i) = $decimal(i)
def $scalar_bytes(FLOAT n) = $f64_format(n, 14)
def $scalar_bytes(STREAM n) = [ 82, 101, 115, 111, 117, 114, 99, 101, 32, 105, 100, 32, 35 ] ++ $digits(n) ;; Resource id #
def $scalar_bytes(TRUE) = [ 49 ]
def $scalar_bytes(FALSE) = eps
def $scalar_bytes(NULL) = eps
def $scalar_bytes(slotValue) = [ 65, 114, 114, 97, 121 ] ;; Array
  -- if $is_array_value(slotValue)

syntax lengthResult = LENGTH nat | NULL_LENGTH | LENGTH_ERROR bytes

dec $strlen(slotValue, bool) : lengthResult
def $strlen(STRING bytes, true) = LENGTH $(|bytes|)
def $strlen(NULL, false) = NULL_LENGTH
def $strlen(slotValue, false) = LENGTH $(|bytes|)
  -- if slotValue =/= NULL /\ $simple_value(slotValue) /\ $scalar_type_bit(slotValue) =/= 512
  -- if bytes = $scalar_bytes(slotValue)
def $strlen(slotValue, b_strict) = LENGTH_ERROR $value_name(slotValue)
  -- if $is_array_value(slotValue) \/ $scalar_type_bit(slotValue) = 512 \/ (b_strict /\ $scalar_type_bit(slotValue) =/= 64)
