;; The caller supplies registered lookup keys with their typed values and
;; optional deprecation diagnostics. These three global names denote PHP literals.
syntax constantInfo = CONST_INFO slotValue bytes?
syntax pair<K, V> = K ':' V
syntax map<K, V> = `{ pair<K, V>* `}
syntax predefinedConstants = map<bytes, constantInfo>

builtin dec $find_map<K, V>(map<K, V>, K) : V?

dec $predefined_value(bytes, constantInfo?) : constantInfo?
def $predefined_value([84, 82, 85, 69], _) = CONST_INFO TRUE eps
def $predefined_value([70, 65, 76, 83, 69], _) = CONST_INFO FALSE eps
def $predefined_value([78, 85, 76, 76], _) = CONST_INFO NULL eps
def $predefined_value(_, constantInfo?) = constantInfo? -- otherwise

dec $builtin_constant(predefinedConstants, bytes) : constantInfo?
def $builtin_constant(predefinedConstants, bytes) =
  $predefined_value(bytes, $find_map<bytes, constantInfo>(predefinedConstants, bytes))
