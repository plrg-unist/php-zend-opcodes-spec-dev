syntax comparisonMode = {
  STRICT bool, EQUALITY bool, SCRIPT bytes, CELLS slotValue*, TABLES borrowedTable*, ACTIVE arrayId*
}
syntax valueOrder = ORDER int | UNKNOWN_ORDER | RECURSIVE_ORDER | POSSIBLE_RECURSION bool
;; The flag records whether an ordinary comparison can also find equality.
dec $may_recurse(valueOrder) : bool
def $may_recurse(valueOrder) = valueOrder <- [RECURSIVE_ORDER, POSSIBLE_RECURSION false, POSSIBLE_RECURSION true]
dec $may_equal(valueOrder) : bool
def $may_equal(valueOrder) = valueOrder <- [ORDER 0, UNKNOWN_ORDER, POSSIBLE_RECURSION true]

;; An unresolved prefix may match. Preserve a recursive error that would be
;; reached before a later key could settle the outer comparison.
dec $unknown_before(valueOrder, valueOrder) : valueOrder
def $unknown_before(valueOrder_l, valueOrder_r) = POSSIBLE_RECURSION $may_equal(valueOrder_r)
  -- if $may_recurse(valueOrder_l) \/ $may_recurse(valueOrder_r)
def $unknown_before(_, _) = UNKNOWN_ORDER -- otherwise

dec $compare_deref(comparisonMode, slotValue) : slotValue
def $compare_deref(comparisonMode, slotValue) = $cell_value(comparisonMode.TABLES, comparisonMode.CELLS, slotValue)
dec $value_order(comparisonMode, slotValue, slotValue) : valueOrder

dec $found_order(comparisonMode, slotValue, slotValue?) : valueOrder
def $found_order(comparisonMode, slotValue_l, slotValue_r) = $value_order(comparisonMode, slotValue_l, slotValue_r)
def $found_order(_, _, eps) = ORDER 1

;; Strict comparisons use insertion order. Loose comparisons look up the left key
;; in the right array when the entries at the same position have different keys.
dec $entry_order(comparisonMode, runtimeEntry, runtimeEntry, runtimeEntry*) : valueOrder
def $entry_order(comparisonMode, ITEM arraykey slotValue_l, ITEM arraykey slotValue_r, _) =
  $value_order(comparisonMode, slotValue_l, slotValue_r)
def $entry_order(comparisonMode, ITEM arraykey_l _, ITEM arraykey_r _, _) = ORDER 1
  -- if arraykey_l =/= arraykey_r /\ comparisonMode.STRICT
def $entry_order(comparisonMode, ITEM arraykey_l slotValue_l, ITEM arraykey_r _, runtimeEntry*) =
  $found_order(comparisonMode, slotValue_l, $array_find(runtimeEntry*, arraykey_l))
  -- if arraykey_l =/= arraykey_r /\ ~comparisonMode.STRICT

;; Stop at the first differing or unknown entry. Splitting the range bounds the
;; interpreter's call depth even when coverage records each individual step.
dec $entry_range(comparisonMode, runtimeEntry*, runtimeEntry*, nat, nat) : valueOrder
dec $entry_rest(comparisonMode, runtimeEntry*, runtimeEntry*, nat, nat, valueOrder) : valueOrder
def $entry_range(_, _, _, n, n) = ORDER 0
def $entry_range(comparisonMode, runtimeEntry_l*, runtimeEntry_r*, n, n_end) =
  $entry_order(comparisonMode, runtimeEntry_l*[n], runtimeEntry_r*[n], runtimeEntry_r*)
  -- if n_end = $(n + 1)
def $entry_range(comparisonMode, runtimeEntry_l*, runtimeEntry_r*, n_start, n_end) =
  $entry_rest(comparisonMode, runtimeEntry_l*, runtimeEntry_r*, n_mid, n_end,
              $entry_range(comparisonMode, runtimeEntry_l*, runtimeEntry_r*, n_start, n_mid))
  -- if $(n_start + 1 < n_end)
  -- if n_mid = $((n_start + n_end) / 2)
def $entry_rest(comparisonMode, runtimeEntry_l*, runtimeEntry_r*, n_mid, n_end, ORDER 0) =
  $entry_range(comparisonMode, runtimeEntry_l*, runtimeEntry_r*, n_mid, n_end)
def $entry_rest(comparisonMode, runtimeEntry_l*, runtimeEntry_r*, n_mid, n_end, valueOrder) =
  $unknown_before(valueOrder, $entry_range(comparisonMode, runtimeEntry_l*, runtimeEntry_r*, n_mid, n_end))
  -- if valueOrder <- [UNKNOWN_ORDER, POSSIBLE_RECURSION true]
def $entry_rest(_, _, _, _, _, valueOrder) = valueOrder -- if ~$may_equal(valueOrder)

;; Loose comparisons with null or a boolean use array emptiness. Arrays rank
;; above every integer, float (including NaN), string, and resource.
dec $array_scalar_order(bool, slotValue, slotValue) : int
def $array_scalar_order(false, slotValue_a, slotValue_s) = $bool_order($truth(slotValue_a), $truth(slotValue_s))
  -- if $($scalar_type_bit(slotValue_s) < 16)
def $array_scalar_order(_, _, _) = 1
  -- otherwise

dec $server_pair_order(comparisonMode, slotValue, slotValue) : valueOrder
dec $mixed_equality(comparisonMode, slotValue, runtimeEntry*, bool) : valueOrder

dec $comparison_table(slotValue) : arrayId
def $comparison_table(ARRAY_VALUE arrayId _ _ _) = arrayId
def $comparison_table(slotValue) = $server_id(slotValue) -- if $server_array(slotValue)

dec $table_order(comparisonMode, slotValue, slotValue) : valueOrder
def $table_order(_, ARRAY_VALUE _ runtimeEntry_l* _ _, ARRAY_VALUE _ runtimeEntry_r* _ _) =
  ORDER $int_order(|runtimeEntry_l*|, |runtimeEntry_r*|)
  -- if |runtimeEntry_l*| =/= |runtimeEntry_r*|
def $table_order(comparisonMode, ARRAY_VALUE _ runtimeEntry_l* _ _, ARRAY_VALUE _ runtimeEntry_r* _ _) =
  $entry_range(comparisonMode, runtimeEntry_l*, runtimeEntry_r*, 0, |runtimeEntry_l*|)
  -- if |runtimeEntry_l*| = |runtimeEntry_r*|
def $table_order(comparisonMode, slotValue_l, slotValue_r) = $server_pair_order(comparisonMode, slotValue_l, slotValue_r)
  -- if $server_array(slotValue_l) /\ $server_array(slotValue_r)
def $table_order(_, slotValue_l, ARRAY_VALUE _ runtimeEntry* _ _) = ORDER 1
  -- if $server_array(slotValue_l)
  -- if $(|runtimeEntry*| < $server_min_size(slotValue_l))
def $table_order(_, ARRAY_VALUE _ runtimeEntry* _ _, slotValue_r) = ORDER (-1)
  -- if $server_array(slotValue_r)
  -- if $(|runtimeEntry*| < $server_min_size(slotValue_r))
def $table_order(comparisonMode, slotValue_l, ARRAY_VALUE _ runtimeEntry* _ _) =
  $mixed_equality(comparisonMode, slotValue_l, runtimeEntry*, false)
  -- if comparisonMode.EQUALITY /\ $server_array(slotValue_l)
  -- if $(|runtimeEntry*| >= $server_min_size(slotValue_l))
def $table_order(comparisonMode, ARRAY_VALUE _ runtimeEntry* _ _, slotValue_r) =
  $mixed_equality(comparisonMode, slotValue_r, runtimeEntry*, true)
  -- if comparisonMode.EQUALITY /\ $server_array(slotValue_r)
  -- if $(|runtimeEntry*| >= $server_min_size(slotValue_r))
def $table_order(_, _, _) = UNKNOWN_ORDER -- otherwise

;; Zend accepts identical table pointers before checking recursion. It protects
;; the left table while comparing its entries, including the initial size test.
dec $array_order(comparisonMode, arrayId, arrayId, slotValue, slotValue) : valueOrder
def $array_order(_, arrayId, arrayId, _, _) = ORDER 0
def $array_order(comparisonMode, arrayId_l, arrayId_r, _, _) = RECURSIVE_ORDER
  -- if arrayId_l =/= arrayId_r /\ (arrayId_l <- comparisonMode.ACTIVE)
def $array_order(comparisonMode, arrayId_l, arrayId_r, slotValue_l, slotValue_r) =
  $table_order(comparisonMode[.ACTIVE = arrayId_l :: comparisonMode.ACTIVE], slotValue_l, slotValue_r)
  -- if arrayId_l =/= arrayId_r /\ ~(arrayId_l <- comparisonMode.ACTIVE)

dec $strict_pointer(slotValue) : bool
def $strict_pointer(REFERENCE _) = true
def $strict_pointer(ELEMENT_LOCATION _ _) = true
def $strict_pointer(SYMBOL_LOCATION _) = true
def $strict_pointer(_) = false -- otherwise

dec $typed_host_order(comparisonMode, nat*, slotValue, int) : valueOrder
def $typed_host_order(comparisonMode, n_type*, FLOAT n, _) = ORDER 1
  -- if $is_nan(FLOAT n) /\ ~(2 <- n_type*) /\ (~comparisonMode.STRICT \/ (32 <- n_type*))
def $typed_host_order(comparisonMode, n_type*, slotValue, i) = ORDER i
  -- if (comparisonMode.STRICT /\ ~($scalar_type_bit(slotValue) <- n_type*)) \/
        (~comparisonMode.STRICT /\ $is_array_value(slotValue) /\ ~(2 <- n_type*))
def $typed_host_order(_, _, _, _) = UNKNOWN_ORDER -- otherwise

dec $deref_order(comparisonMode, slotValue, slotValue) : valueOrder
def $deref_order(comparisonMode, slotValue_l, slotValue_r) = ORDER 1
  -- if comparisonMode.STRICT /\ ($strict_pointer(slotValue_l) \/ $strict_pointer(slotValue_r))
;; An inherited environment value or finite request timestamp equals itself.
def $deref_order(_, HOST_OFFSET hostSource, HOST_OFFSET hostSource) = ORDER 0
def $deref_order(comparisonMode, HOST_OFFSET hostSource_l, HOST_OFFSET hostSource_r) = ORDER 1
  -- if comparisonMode.STRICT
  -- if slotValue_l* = $host_type_values(HOST_OFFSET hostSource_l)
  -- if slotValue_r* = $host_type_values(HOST_OFFSET hostSource_r)
  -- if ~(true <- (slotValue_l <- slotValue_r*)*)
def $deref_order(comparisonMode, HOST_OFFSET hostSource, slotValue) =
  $typed_host_order(comparisonMode, ($scalar_type_bit(slotValue_type))*, slotValue, -1)
  -- if $known_value(slotValue)
  -- if slotValue_type* = $host_type_values(HOST_OFFSET hostSource)
def $deref_order(comparisonMode, slotValue, HOST_OFFSET hostSource) =
  $typed_host_order(comparisonMode, ($scalar_type_bit(slotValue_type))*, slotValue, 1)
  -- if $known_value(slotValue)
  -- if slotValue_type* = $host_type_values(HOST_OFFSET hostSource)
def $deref_order(comparisonMode, slotValue_l, slotValue_r) = ORDER $bool_order(~$identical_scalar(slotValue_l, slotValue_r), false)
  -- if $simple_value(slotValue_l) /\ $simple_value(slotValue_r) /\ comparisonMode.STRICT
def $deref_order(comparisonMode, slotValue_l, slotValue_r) = ORDER $simple_order(slotValue_l, slotValue_r)
  -- if $simple_value(slotValue_l) /\ $simple_value(slotValue_r) /\ ~comparisonMode.STRICT
def $deref_order(comparisonMode, slotValue_l, slotValue_r) =
  $array_order(comparisonMode, $comparison_table(slotValue_l), $comparison_table(slotValue_r), slotValue_l, slotValue_r)
  -- if $is_array_value(slotValue_l) /\ $is_array_value(slotValue_r)
def $deref_order(comparisonMode, slotValue_l, slotValue_r) = ORDER $array_scalar_order(comparisonMode.STRICT, slotValue_l, slotValue_r)
  -- if $is_array_value(slotValue_l) /\ $simple_value(slotValue_r)
  -- if comparisonMode.STRICT \/ $($scalar_type_bit(slotValue_r) >= 16) \/ $truth_known(slotValue_l)
def $deref_order(comparisonMode, slotValue_l, slotValue_r) = ORDER $(-$array_scalar_order(comparisonMode.STRICT, slotValue_r, slotValue_l))
  -- if $simple_value(slotValue_l) /\ $is_array_value(slotValue_r)
  -- if comparisonMode.STRICT \/ $($scalar_type_bit(slotValue_l) >= 16) \/ $truth_known(slotValue_r)
def $deref_order(_, _, _) = UNKNOWN_ORDER -- otherwise

def $value_order(comparisonMode, slotValue_l, slotValue_r) =
  $deref_order(comparisonMode, $compare_deref(comparisonMode, slotValue_l), $compare_deref(comparisonMode, slotValue_r))

dec $comparison_result(opcode, valueOrder) : numericResult
def $comparison_result(opcode, ORDER i) = NUM_VALUE $order_result(opcode, i)
def $comparison_result(_, valueOrder) = NUM_UNSUPPORTED -- if valueOrder <- [UNKNOWN_ORDER, POSSIBLE_RECURSION false, POSSIBLE_RECURSION true]

;; Error: Nesting level too deep - recursive dependency?
def $comparison_result(_, RECURSIVE_ORDER) =
  NUM_ERROR ([ 69, 114, 114, 111, 114, 58, 32, 78, 101, 115, 116, 105, 110, 103, 32, 108, 101, 118, 101, 108,
      32, 116, 111, 111, 32, 100, 101, 101, 112, 32, 45, 32, 114, 101, 99, 117, 114, 115, 105, 118, 101, 32,
      100, 101, 112, 101, 110, 100, 101, 110, 99, 121, 63 ])
