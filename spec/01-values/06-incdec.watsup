;; String ++ carries through the trailing run of 9, Z and z, even when their classes differ.
dec $carry_start(bytes, nat) : nat
def $carry_start(bytes, n) = $carry_start(bytes, n_prev)
  -- if $(n > 0)
  -- if n_prev = $(n - 1)
  -- if bytes[n_prev] <- [ 57, 90, 122 ]
def $carry_start(_, n) = n
  -- otherwise

dec $increment_ascii(nat) : nat
def $increment_ascii(57) = 48
def $increment_ascii(90) = 65
def $increment_ascii(122) = 97
def $increment_ascii(n) = $(n + 1)
  -- if $(48 <= n) /\ $(n < 57) \/ $(65 <= n) /\ $(n < 90) \/ $(97 <= n) /\ $(n < 122)
def $increment_ascii(n) = n
  -- otherwise

;; A carry past a leading 9 adds 1. A carry past a leading Z or z adds A or a.
;; An empty string grows to "1".
dec $increment_prefix(bytes, nat) : bytes
def $increment_prefix(90 :: _, 0) = [ 65 ]
def $increment_prefix(122 :: _, 0) = [ 97 ]
def $increment_prefix(bytes, n) = bytes[0 : n_prev] ++ [ $increment_ascii(bytes[n_prev]) ]
  -- if $(n > 0)
  -- if n_prev = $(n - 1)
def $increment_prefix(_, _) = [ 49 ]
  -- otherwise

dec $increment_text(bytes) : bytes
def $increment_text(bytes) = $increment_prefix(bytes, n) ++ ($increment_ascii(n_carried))*
  -- if n = $carry_start(bytes, |bytes|)
  -- if n_count = $(|bytes| - n)
  -- if n_carried* = bytes[n : n_count]

dec $incdec_name(opcode) : bytes
def $incdec_name(ADD) = [ 73, 110, 99, 114, 101, 109, 101, 110, 116 ]     ;; Increment
def $incdec_name(SUB) = [ 68, 101, 99, 114, 101, 109, 101, 110, 116 ]     ;; Decrement

dec $incdec_no_effect(opcode, zval, bytes) : numericResult
def $incdec_no_effect(opcode, zval, bytes_type) = NUM_WARNING ($incdec_name(opcode)
    ++ [ 32, 111, 110, 32, 116, 121, 112, 101, 32 ] ++ bytes_type
    ;; " has no effect, this will change in the next major version of PHP"
    ++ [ 32, 104, 97, 115, 32, 110, 111, 32, 101, 102, 102, 101, 99, 116, 44, 32, 116, 104, 105,
      115, 32, 119, 105, 108, 108, 32, 99, 104, 97, 110, 103, 101, 32, 105, 110, 32, 116,
      104, 101, 32, 110, 101, 120, 116, 32, 109, 97, 106, 111, 114, 32, 118, 101, 114, 115,
      105, 111, 110, 32, 111, 102, 32, 80, 72, 80 ]) (NUM_VALUE zval)

dec $incdec_text(opcode, bytes) : numericResult
;; Increment on non-numeric string is deprecated, use str_increment() instead
def $incdec_text(ADD, bytes) = NUM_DEPRECATED
    ([ 73, 110, 99, 114, 101, 109, 101, 110, 116, 32, 111, 110, 32, 110, 111, 110, 45, 110,
      117, 109, 101, 114, 105, 99, 32, 115, 116, 114, 105, 110, 103, 32, 105, 115, 32, 100,
      101, 112, 114, 101, 99, 97, 116, 101, 100, 44, 32, 117, 115, 101, 32, 115, 116, 114,
      95, 105, 110, 99, 114, 101, 109, 101, 110, 116, 40, 41, 32, 105, 110, 115, 116, 101,
      97, 100 ]) (NUM_VALUE (STRING $increment_text(bytes)))
;; Decrement on empty string is deprecated as non-numeric
def $incdec_text(SUB, eps) = NUM_DEPRECATED
    ([ 68, 101, 99, 114, 101, 109, 101, 110, 116, 32, 111, 110, 32, 101, 109, 112, 116, 121,
      32, 115, 116, 114, 105, 110, 103, 32, 105, 115, 32, 100, 101, 112, 114, 101, 99, 97,
      116, 101, 100, 32, 97, 115, 32, 110, 111, 110, 45, 110, 117, 109, 101, 114, 105, 99 ]) (NUM_VALUE (INT $(-1)))
;; Decrement on non-numeric string has no effect and is deprecated
def $incdec_text(SUB, bytes) = NUM_DEPRECATED
    ([ 68, 101, 99, 114, 101, 109, 101, 110, 116, 32, 111, 110, 32, 110, 111, 110, 45, 110,
      117, 109, 101, 114, 105, 99, 32, 115, 116, 114, 105, 110, 103, 32, 104, 97, 115, 32,
      110, 111, 32, 101, 102, 102, 101, 99, 116, 32, 97, 110, 100, 32, 105, 115, 32, 100,
      101, 112, 114, 101, 99, 97, 116, 101, 100 ]) (NUM_VALUE (STRING bytes))
  -- if bytes =/= eps

dec $incdec_string(opcode, bytes, zval?) : numericResult
def $incdec_string(opcode, _, zval) = $arithmetic_numbers(opcode, zval, INT 1)
def $incdec_string(opcode, bytes, eps) = $incdec_text(opcode, bytes)

dec $update_scalar(opcode, slotValue) : numericResult
def $update_scalar(opcode, zval) = $arithmetic_numbers(opcode, zval, INT 1)
  -- if $scalar_type_bit(zval) <- [16, 32]
def $update_scalar(opcode, STRING bytes) = $incdec_string(opcode, bytes, $complete_number($numeric_string(bytes)))
def $update_scalar(ADD, NULL) = NUM_VALUE (INT 1)
def $update_scalar(SUB, NULL) = $incdec_no_effect(SUB, NULL, [ 110, 117, 108, 108 ])
def $update_scalar(opcode, zval) = $incdec_no_effect(opcode, zval, [ 98, 111, 111, 108 ])
  -- if zval = TRUE \/ zval = FALSE
;; TypeError: Cannot increment/decrement array
def $update_scalar(opcode, slotValue) = NUM_ERROR
    ([ 84, 121, 112, 101, 69, 114, 114, 111, 114, 58, 32, 67, 97, 110, 110, 111, 116, 32 ]
     ++ bytes_verb ++ [ 32 ] ++ $value_name(slotValue))
  -- if $is_array_value(slotValue)
  -- if n_first :: bytes_tail = $incdec_name(opcode)
  -- if bytes_verb = $(n_first + 32) :: bytes_tail

dec $numeric_incdec(opcode, slotValue) : numericResult
def $numeric_incdec(opcode, slotValue) = $update_scalar(ADD, slotValue)
  -- if opcode = PRE_INC \/ opcode = POST_INC
def $numeric_incdec(opcode, slotValue) = $update_scalar(SUB, slotValue)
  -- if opcode = PRE_DEC \/ opcode = POST_DEC
