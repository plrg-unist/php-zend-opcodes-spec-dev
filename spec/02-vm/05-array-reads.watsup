;; The VM's shared dimension-read helper interprets a numeric string even when
;; its key is literal. FETCH_DIM_R takes that helper only for literal containers.
dec $dimension_key(opcode, operand, operand, slotValue) : slotValue
def $dimension_key(opcode, _, LIT _, STRING bytes) = $string_array_key(bytes)
  -- if opcode = FETCH_DIM_IS \/ opcode = FETCH_LIST_R
def $dimension_key(FETCH_DIM_R, LIT _, LIT _, STRING bytes) = $string_array_key(bytes)
def $dimension_key(_, _, _, slotValue) = slotValue
  -- otherwise

dec $printed_array_key(arraykey) : bytes
def $printed_array_key(INDEX i) = $decimal(i)
def $printed_array_key(KEY bytes) = [34] ++ bytes ++ [34]

dec $missing_array_key(frame, arraykey) : frame
def $missing_array_key(frame, arraykey) = $report(frame, WARNING,
  [ 85, 110, 100, 101, 102, 105, 110, 101, 100, 32, 97, 114, 114, 97, 121, 32, 107, 101, 121, 32 ]
  ++ $printed_array_key(arraykey))  ;; Undefined array key

dec $found_value(slotValue?) : slotValue
def $found_value(slotValue) = slotValue
def $found_value(eps) = NULL

dec $isset_empty(frame, operand, nat, smartbranch?, slotValue) : transition
def $isset_empty(frame, operand_r, 0, smartbranch?, slotValue) =
  CONTINUE $comparison(frame, operand_r, smartbranch?, ~$nullish(slotValue))
  -- if ~$host_offset(slotValue)
def $isset_empty(frame, operand_r, 0, smartbranch?, HOST_OFFSET hostSource) =
  CONTINUE $comparison(frame, operand_r, smartbranch?, true)
  -- if $nonnull_host(HOST_OFFSET hostSource)
def $isset_empty(frame, operand_r, 1, smartbranch?, slotValue) =
  CONTINUE $comparison($truth_frame(frame, slotValue), operand_r, smartbranch?, ~$truth(slotValue))
  -- if ~$host_offset(slotValue) /\ $truth_known(slotValue)
def $isset_empty(frame, _, _, _, _) = FINISH (UNSUPPORTED frame.STDOUT eps) -- otherwise

dec $read_array_entry(frame, opcode, arraykey, slotValue?) : (frame, slotValue)
def $read_array_entry(frame, FETCH_DIM_R, arraykey, eps) = ($missing_array_key(frame, arraykey), NULL)
def $read_array_entry(frame, opcode, _, slotValue?) = (frame, $deref(frame, $found_value(slotValue?)))
  -- if opcode = FETCH_DIM_IS \/ slotValue? =/= eps

dec $lookup_result(frame, opcode, operand, nat, smartbranch?, arraykey, slotValue?) : transition
def $lookup_result(frame, opcode, operand_r, _, _, arraykey, slotValue?) = CONTINUE $write(frame', operand_r, slotValue_read)
  -- if opcode = FETCH_DIM_IS \/ opcode = FETCH_DIM_R
  -- if (frame', slotValue_read) = $read_array_entry(frame, opcode, arraykey, slotValue?)
def $lookup_result(frame, ARRAY_KEY_EXISTS, operand_r, _, smartbranch?, _, slotValue?) =
  CONTINUE $comparison(frame, operand_r, smartbranch?, slotValue? =/= eps)
def $lookup_result(frame, ISSET_ISEMPTY_DIM_OBJ, operand_r, n, smartbranch?, _, slotValue?) =
  $isset_empty(frame, operand_r, $(n \ 2), smartbranch?, $deref(frame, $found_value(slotValue?)))

dec $server_result(frame, opcode, operand, nat, smartbranch?, arraykey, serverLookup) : transition
def $server_result(frame, opcode, operand_r, n, smartbranch?, arraykey, SERVER_KNOWN slotValue?) =
  $lookup_result(frame, opcode, operand_r, n, smartbranch?, arraykey, slotValue?)
def $server_result(frame, opcode, operand_r, n, smartbranch?, _, SERVER_PRESENT) =
  CONTINUE $comparison(frame, operand_r, smartbranch?, true)
  -- if opcode = ARRAY_KEY_EXISTS \/ (opcode = ISSET_ISEMPTY_DIM_OBJ /\ $(n \ 2 = 0))
def $server_result(frame, opcode, operand_r, n, smartbranch?, arraykey, SERVER_CAPTURED hostSource) =
  $lookup_result(frame, opcode, operand_r, n, smartbranch?, arraykey, HOST_OFFSET hostSource)
def $server_result(frame, _, _, _, _, _, _) = FINISH (UNSUPPORTED frame.STDOUT eps)
  -- otherwise

;; Key conversions can emit warnings and deprecations before the lookup.
dec $converted_lookup(frame, opcode, operand, nat, smartbranch?, slotValue, numericResult) : transition
def $converted_lookup(frame, opcode, operand_r, n, smartbranch?, ARRAY_VALUE _ runtimeEntry* _ _, NUM_VALUE slotValue_key) =
  $lookup_result(frame, opcode, operand_r, n, smartbranch?, arraykey, $array_find(runtimeEntry*, arraykey))
  -- if arraykey = $array_key_tag(slotValue_key)
def $converted_lookup(frame, opcode, operand_r, n, smartbranch?, slotValue_server, NUM_VALUE slotValue_key) =
  $server_result(frame, opcode, operand_r, n, smartbranch?, arraykey, $server_entry(slotValue_server, arraykey, frame.SCRIPT))
  -- if $server_array(slotValue_server)
  -- if arraykey = $array_key_tag(slotValue_key)
def $converted_lookup(frame, opcode, operand_r, n, smartbranch?, slotValue, NUM_WARNING bytes numericResult) =
  $converted_lookup($report(frame, WARNING, bytes), opcode, operand_r, n, smartbranch?, slotValue, numericResult)
def $converted_lookup(frame, opcode, operand_r, n, smartbranch?, slotValue, NUM_DEPRECATED bytes numericResult) =
  $converted_lookup($report(frame, DEPRECATED, bytes), opcode, operand_r, n, smartbranch?, slotValue, numericResult)
def $converted_lookup(frame, _, _, _, _, _, NUM_ERROR bytes) = $raise(frame, bytes)

;; Warning: Trying to access array offset on <type>
dec $scalar_offset_frame(frame, opcode, slotValue) : frame
def $scalar_offset_frame(frame, FETCH_DIM_R, slotValue) = $report(frame, WARNING,
  [ 84, 114, 121, 105, 110, 103, 32, 116, 111, 32, 97, 99, 99, 101, 115, 115, 32,
    97, 114, 114, 97, 121, 32, 111, 102, 102, 115, 101, 116, 32, 111, 110, 32 ] ++ $value_name(slotValue))
def $scalar_offset_frame(frame, FETCH_DIM_IS, _) = frame

dec $scalar_query(frame, opcode, operand, nat, smartbranch?, slotValue) : transition
;; TypeError: array_key_exists(): Argument #2 ($array) must be of type array, <type> given
def $scalar_query(frame, ARRAY_KEY_EXISTS, _, _, _, slotValue) = $raise(frame,
    [ 84, 121, 112, 101, 69, 114, 114, 111, 114, 58, 32, 97, 114, 114, 97, 121, 95, 107, 101, 121,
      95, 101, 120, 105, 115, 116, 115, 40, 41, 58, 32, 65, 114, 103, 117, 109, 101, 110, 116, 32,
      35, 50, 32, 40, 36, 97, 114, 114, 97, 121, 41, 32, 109, 117, 115, 116, 32, 98, 101, 32,
      111, 102, 32, 116, 121, 112, 101, 32, 97, 114, 114, 97, 121, 44, 32 ]
    ++ $value_name(slotValue) ++ [ 32, 103, 105, 118, 101, 110 ])
def $scalar_query(frame, opcode, operand_r, _, _, slotValue) =
  CONTINUE $write($scalar_offset_frame(frame, opcode, slotValue), operand_r, NULL)
  -- if opcode = FETCH_DIM_R \/ opcode = FETCH_DIM_IS
def $scalar_query(frame, ISSET_ISEMPTY_DIM_OBJ, operand_r, n, smartbranch?, _) =
  CONTINUE $comparison(frame, operand_r, smartbranch?, $(n \ 2 = 1))

relation ArrayQuery: frame; opcode; operand; operand; operand; nat; smartbranch?; slotValue; slotValue ~> transition
  hint(input %0 %1 %2 %3 %4 %5 %6 %7 %8)
dec $query_string_offset(frame, opcode, operand, operand, operand, nat, smartbranch?, bytes?, slotValue) : transition
rule ArrayQuery/string:
  frame; opcode; operand_r; operand_a; operand_k; n; smartbranch?; (STRING bytes); slotValue_k ~>
    $query_string_offset(frame, opcode, operand_r, operand_a, operand_k, n, smartbranch?, bytes, slotValue_k)
  -- if opcode =/= ARRAY_KEY_EXISTS
  -- if opcode = ISSET_ISEMPTY_DIM_OBJ \/ $known_value(slotValue_k) \/ slotValue_k = UNDEF
rule ArrayQuery/host-string:
  frame; opcode; operand_r; operand_a; operand_k; n; smartbranch?; (HOST_OFFSET hostSource); slotValue_k ~>
    $query_string_offset(frame, opcode, operand_r, operand_a, operand_k, n, smartbranch?, eps, slotValue_k)
  -- if opcode =/= ARRAY_KEY_EXISTS
  -- if [STRING eps] = $host_type_values(HOST_OFFSET hostSource)
rule ArrayQuery/array:
  frame; opcode; operand_r; operand_a; operand_k; n; smartbranch?; slotValue_a; slotValue_k ~>
    $converted_lookup(frame, opcode, operand_r, n, smartbranch?, slotValue_a, $vm_array_key(frame, opcode, operand_k, slotValue_key))
  -- if $is_array_value(slotValue_a)
  -- if $known_value(slotValue_k) \/ (slotValue_k = UNDEF)
  -- if slotValue_key = $dimension_key(opcode, operand_a, operand_k, slotValue_k)
rule ArrayQuery/host-scalar:
  frame; ARRAY_KEY_EXISTS; operand_r; _; _; n; smartbranch?; (HOST_OFFSET hostSource); _ ~>
    $scalar_query(frame, ARRAY_KEY_EXISTS, operand_r, n, smartbranch?, slotValue)
  -- if [slotValue] = $host_type_values(HOST_OFFSET hostSource)
rule ArrayQuery/scalar:
  frame; opcode; operand_r; _; _; n; smartbranch?; slotValue_a; _ ~>
    $scalar_query(frame, opcode, operand_r, n, smartbranch?, $deref(frame, slotValue_a))
  -- if $simple_value(slotValue_a) \/ (slotValue_a = UNDEF)
    \/ (opcode = ARRAY_KEY_EXISTS /\ $is_reference(slotValue_a))
    \/ (~$is_array_value(slotValue_a) /\ ~$host_offset(slotValue_a) /\ (opcode = FETCH_DIM_IS \/ opcode = ISSET_ISEMPTY_DIM_OBJ))
  -- if opcode = ARRAY_KEY_EXISTS \/ $scalar_type_bit(slotValue_a) =/= 64

dec $dim_container(frame, opcode, operand) : (frame, slotValue)
def $dim_container(frame, FETCH_DIM_R, operand) = $read_operand(frame, operand)
def $dim_container(frame, FETCH_DIM_IS, operand) = (frame, $read(frame, operand))
def $dim_container(frame, ISSET_ISEMPTY_DIM_OBJ, operand) =
  (frame, $copy_value(frame, operand, $read(frame, operand)))

dec $count_name(nat) : bytes
def $count_name(0) = [ 99, 111, 117, 110, 116 ]
def $count_name(n) = [ 115, 105, 122, 101, 111, 102 ] -- if n =/= 0

;; IN_ARRAY stores the haystack as a set of keys. Loose-mode tables contain
;; string keys, compared as bytes for a string needle and by PHP equality otherwise.
dec $in_keyset(slotValue, arraykey*, nat) : bool
def $in_keyset(STRING bytes, arraykey*, _) = (KEY bytes) <- arraykey*
def $in_keyset(INT i, arraykey*, n) = (INDEX i) <- arraykey* -- if n =/= 0
def $in_keyset(slotValue, arraykey*, 0) = (KEY eps) <- arraykey*
  -- if $nullish(slotValue) \/ (slotValue = FALSE)
def $in_keyset(slotValue, (KEY bytes)*, 0) = true <- ($simple_order(slotValue, STRING bytes) = 0)*
  -- if $scalar_type_bit(slotValue) <- [8, 16, 32, 512]
def $in_keyset(_, _, _) = false -- otherwise

;; A wrapped loose needle reaches the general comparison loop. CV and VAR
;; obtain a second chance at the string-key fast path after being unwrapped.
dec $compare_needle(frame, operand, slotValue, nat) : bool
def $compare_needle(frame, operand, slotValue, n) =
  n = 0 /\ $is_reference($raw_read(frame, operand)) /\ $simple_value(slotValue)
    /\ ($scalar_type_bit(slotValue) =/= 64 \/ $is_reference($copy_value(frame, operand, slotValue)))

dec $membership_needle(frame, operand, slotValue, arraykey*, nat) : bool
def $membership_needle(frame, operand, slotValue, (KEY bytes)*, 0) = true <- ($simple_order(slotValue, STRING bytes) = 0)*
  -- if $compare_needle(frame, operand, slotValue, 0)
def $membership_needle(frame, operand, slotValue, arraykey*, n) =
  (n = 0 \/ ~$is_reference($copy_value(frame, operand, slotValue))) /\ $in_keyset(slotValue, arraykey*, n)
  -- if ~$compare_needle(frame, operand, slotValue, n)

dec $array_builtin(frame, opcode, operand, slotValue, arraykey*, nat) : numericResult
def $array_builtin(frame, COUNT, operand, HOST_OFFSET hostSource, _, n) =
  $array_builtin(frame, COUNT, operand, slotValue, eps, n)
  -- if [slotValue] = $host_type_values(HOST_OFFSET hostSource)
def $array_builtin(frame, COUNT, operand, slotValue, _, _) = NUM_VALUE (INT $(|runtimeEntry*|))
  -- if ARRAY_VALUE _ runtimeEntry* _ _ = slotValue
  -- if ~$is_reference($copy_value(frame, operand, slotValue))
;; TypeError: count()/sizeof(): Argument #1 ($value) must be of type Countable|array, <type> given
def $array_builtin(frame, COUNT, operand, slotValue, _, n) = NUM_ERROR ([ 84, 121, 112, 101, 69, 114, 114, 111, 114, 58, 32 ]
    ++ $count_name(n)
    ++ [ 40, 41, 58, 32, 65, 114, 103, 117, 109, 101, 110, 116, 32, 35, 49, 32, 40, 36, 118, 97, 108,
         117, 101, 41, 32, 109, 117, 115, 116, 32, 98, 101, 32, 111, 102, 32, 116, 121, 112, 101, 32,
         67, 111, 117, 110, 116, 97, 98, 108, 101, 124, 97, 114, 114, 97, 121, 44, 32 ]
    ++ $value_name(slotValue) ++ [ 32, 103, 105, 118, 101, 110 ])
  -- if $simple_value(slotValue) \/ (slotValue = UNDEF) \/ ($is_array_value(slotValue) /\ $is_reference($copy_value(frame, operand, slotValue)))
def $array_builtin(frame, IN_ARRAY, operand, slotValue, arraykey*, n) =
  NUM_VALUE $zend_bool($membership_needle(frame, operand, slotValue, arraykey*, n))
  -- if $known_value(slotValue) \/ (slotValue = UNDEF) \/ (n =/= 0) \/ (arraykey* = eps)
def $array_builtin(_, _, _, _, _, _) = NUM_UNSUPPORTED -- otherwise

rule ArrayReadStep/dimension:
  frame; opcode; operand_r; operand_a; operand_k; extension?; smartbranch? ~> transition
  -- if opcode <- [FETCH_DIM_R, FETCH_DIM_IS, ISSET_ISEMPTY_DIM_OBJ]
  -- if (frame', slotValue_a) = $dim_container(frame, opcode, operand_a)
  -- if slotValue_k = $read(frame', operand_k)
  -- if (frame'', _) = $read_value(frame', operand_k, slotValue_k)
  -- ArrayQuery: frame''; opcode; operand_r; operand_a; operand_k; $ext_value(extension?);
       smartbranch?; slotValue_a; slotValue_k ~> transition
rule ArrayReadStep/key-exists:
  frame; ARRAY_KEY_EXISTS; operand_r; operand_k; operand_a; _; smartbranch? ~> transition
  -- if slotValue_k = $read(frame, operand_k)
  -- if (frame', _) = $read_value(frame, operand_k, slotValue_k)
  -- if (frame'', slotValue_a) = $read_operand(frame', operand_a)
  -- ArrayQuery: frame''; ARRAY_KEY_EXISTS; operand_r; operand_a; operand_k; 0; smartbranch?;
       $copy_value(frame'', operand_a, slotValue_a); slotValue_k ~> transition
rule ArrayReadStep/isset-cv:
  frame; ISSET_ISEMPTY_CV; operand_r; operand_a; _; extension?; smartbranch? ~>
    $isset_empty(frame, operand_r, $($ext_value(extension?) \ 2), smartbranch?, $read(frame, operand_a))
rule ArrayReadStep/count:
  frame; COUNT; operand_r; operand_a; _; extension?; _ ~>
    $apply_numeric(frame', operand_r, UNUSED, eps, $array_builtin(frame', COUNT, operand_a, slotValue, eps, $ext_value(extension?)))
  -- if (frame', slotValue) = $read_operand(frame, operand_a)
rule ArrayReadStep/in-array:
  frame; IN_ARRAY; operand_r; operand_a; (LIT n); extension?; smartbranch? ~>
    $apply_numeric(frame', operand_r, UNUSED, smartbranch?, $array_builtin(frame', IN_ARRAY, operand_a, slotValue, arraykey*, $ext_value(extension?)))
  -- if (frame', slotValue) = $read_operand(frame, operand_a)
  -- if ARRAY_VALUE _ (ITEM arraykey slotValue_entry)* _ _ = $read(frame', LIT n)
