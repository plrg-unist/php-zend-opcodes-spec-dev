def $concat_values(frame, b_same, slotValue_l, slotValue_h) =
  $binary_operation($string_frame(frame, slotValue_l), b_same, CONCAT, slotValue_l, slotValue_h)

rule StringStep/concat:
  frame; CONCAT; operand_r; operand_l; operand_h; _ ~> transition
  -- if (frame_l, slotValue_l) = $read_operand(frame, operand_l)
  -- if (frame_h, slotValue_h) = $read_operand(frame_l, operand_h)
  -- if b_same = (operand_r = operand_l /\ operand_l = operand_h /\ ~$is_reference($raw_read(frame_h, operand_l)))
  -- if (frame_out, numericResult) = $concat_values(frame_h, b_same, slotValue_l, slotValue_h)
  -- if transition = $apply_numeric(frame_out, operand_r, UNUSED, eps, numericResult)

relation StringOperand: frame; operand ~> frame; bytes
  hint(input %0 %1)
rule StringOperand/read:
  frame; operand ~> $string_frame(frame', slotValue); bytes
  -- if (frame', slotValue) = $read_operand(frame, operand)
  -- if $known_value(slotValue)
  -- if bytes = $scalar_bytes(slotValue)

;; FAST_CONCAT converts its left operand before fetching the right operand.
rule StringStep/fast-concat:
  frame; FAST_CONCAT; operand_r; operand_l; operand_h; _ ~> transition
  -- if (frame_l, slotValue_l) = $read_operand(frame, operand_l)
  -- if (frame_h, slotValue_h) = $read_operand($string_frame(frame_l, slotValue_l), operand_h)
  -- if (frame_out, numericResult) = $binary_operation(frame_h, false, CONCAT, slotValue_l, slotValue_h)
  -- if transition = $apply_numeric(frame_out, operand_r, UNUSED, eps, numericResult)

;; A rope retains the bytes converted at each instruction, indexed by its
;; base temporary and fragment number. END joins them in fragment-number order.
dec $forget_rope(nat, fragment*) : fragment*
def $forget_rope(_, eps) = eps
def $forget_rope(n, (FRAGMENT n _ _) :: fragment*) = $forget_rope(n, fragment*)
def $forget_rope(n, fragment_head :: fragment*) = fragment_head :: $forget_rope(n, fragment*)
  -- if FRAGMENT n_base _ _ = fragment_head
  -- if n =/= n_base

relation TakeRopePiece: fragment*; nat; nat ~> bytes; fragment*
  hint(input %0 %1 %2)
rule TakeRopePiece/here:
  ((FRAGMENT n_base n_index bytes) :: fragment*); n_base; n_index ~> bytes; fragment*
rule TakeRopePiece/rest:
  (fragment_head :: fragment*); n_base; n_index ~> bytes; (fragment_head :: fragment_rest*)
  -- if FRAGMENT n_other n_part _ = fragment_head
  -- if n_other =/= n_base \/ n_part =/= n_index
  -- TakeRopePiece: fragment*; n_base; n_index ~> bytes; fragment_rest*

relation RopePrefix: fragment*; nat; nat ~> bytes
  hint(input %0 %1 %2)
rule RopePrefix/empty: fragment*; n_base; 0 ~> eps
rule RopePrefix/part:
  fragment*; n_base; n_count ~> (bytes_prefix ++ bytes_last)
  -- if $(n_count > 0)
  -- if n_index = $(n_count - 1)
  -- TakeRopePiece: fragment*; n_base; n_index ~> bytes_last; fragment_rest*
  -- RopePrefix: fragment_rest*; n_base; n_index ~> bytes_prefix

rule StringStep/rope-init:
  frame; ROPE_INIT; (TMP n_base); _; operand; _
    ~> CONTINUE frame'[.ROPEPARTS = (FRAGMENT n_base 0 bytes) :: $forget_rope(n_base, frame'.ROPEPARTS)]
  -- StringOperand: frame; operand ~> frame'; bytes

rule StringStep/rope-add:
  frame; ROPE_ADD; _; (TMP n_base); operand; extension?
    ~> CONTINUE frame'[.ROPEPARTS = (FRAGMENT n_base n_index bytes) :: frame'.ROPEPARTS]
  -- StringOperand: frame; operand ~> frame'; bytes
  -- if n_index = $ext_value(extension?)

rule StringStep/rope-end:
  frame; ROPE_END; operand_r; (TMP n_base); operand; extension?
    ~> CONTINUE $write(frame_clean, operand_r, STRING (bytes_prefix ++ bytes_last))
  -- StringOperand: frame; operand ~> frame'; bytes_last
  -- RopePrefix: frame'.ROPEPARTS; n_base; $ext_value(extension?) ~> bytes_prefix
  -- if frame_clean = frame'[.ROPEPARTS = $forget_rope(n_base, frame'.ROPEPARTS)]

dec $apply_length(frame, operand, slotValue, lengthResult, bool) : transition
def $apply_length(frame, operand, slotValue, LENGTH n, _) = CONTINUE $write($string_frame(frame, slotValue), operand, INT n)
;; strlen(): Passing null to parameter #1 ($string) of type string is deprecated
def $apply_length(frame, operand, _, NULL_LENGTH, _) = CONTINUE $write(frame', operand, INT 0)
  -- if frame' = $report(frame, DEPRECATED,
      [ 115, 116, 114, 108, 101, 110, 40, 41, 58, 32, 80, 97, 115, 115, 105, 110, 103, 32,
        110, 117, 108, 108, 32, 116, 111, 32, 112, 97, 114, 97, 109, 101, 116, 101, 114, 32,
        35, 49, 32, 40, 36, 115, 116, 114, 105, 110, 103, 41, 32, 111, 102, 32, 116, 121,
        112, 101, 32, 115, 116, 114, 105, 110, 103, 32, 105, 115, 32, 100, 101, 112, 114, 101,
        99, 97, 116, 101, 100 ])
;; Both entry points share PHP string coercion. The ordinary call adds strlen to the exception trace.
dec $strlen_type_error(bytes) : bytes
def $strlen_type_error(bytes_type) =
    [ 84, 121, 112, 101, 69, 114, 114, 111, 114, 58, 32, 115, 116, 114, 108, 101, 110,
        40, 41, 58, 32, 65, 114, 103, 117, 109, 101,
        110, 116, 32, 35, 49, 32, 40, 36, 115, 116, 114, 105, 110, 103, 41, 32, 109, 117,
        115, 116, 32, 98, 101, 32, 111, 102, 32, 116, 121, 112, 101, 32, 115, 116, 114, 105,
        110, 103, 44, 32 ]
      ++ bytes_type ++ [ 32, 103, 105, 118, 101, 110 ]
def $apply_length(frame, _, _, LENGTH_ERROR bytes_type, false) = $raise(frame, $strlen_type_error(bytes_type))
def $apply_length(frame, _, slotValue, LENGTH_ERROR bytes_type, true) =
  $raise_strlen(frame, $strlen_type_error(bytes_type), [slotValue])

def $length_result(frame, operand, slotValue, lengthResult) = $apply_length(frame, operand, slotValue, lengthResult, false)

def $call_strlen(frame, operand, [slotValue]) =
  $apply_length(frame, operand, slotValue, $strlen(slotValue, frame.STRICT), true)
  -- if $known_value(slotValue)
;; SEND_VAL can transfer a reference from a temporary. Zend's string parameter parser rejects
;; the wrapper and its type-error message names the referenced value.
def $call_strlen(frame, _, [REFERENCE n]) =
  $raise_strlen(frame, $strlen_type_error($value_name(slotValue)), [slotValue])
  -- if slotValue = $deref(frame, REFERENCE n)
  -- if $known_value(slotValue)
def $call_strlen(frame, _, slotValue*) = $raise_strlen(frame, bytes_msg, slotValue*)
  -- if |slotValue*| =/= 1
  ;; ArgumentCountError: strlen() expects exactly 1 argument, <n> given
  -- if bytes_msg = [ 65, 114, 103, 117, 109, 101, 110, 116, 67, 111, 117, 110, 116, 69, 114, 114, 111,
      114, 58, 32, 115, 116, 114, 108, 101, 110, 40, 41, 32, 101, 120, 112, 101, 99, 116,
      115, 32, 101, 120, 97, 99, 116, 108, 121, 32, 49, 32, 97, 114, 103, 117, 109, 101,
      110, 116, 44, 32 ]
      ++ $digits(|slotValue*|) ++ [ 32, 103, 105, 118, 101, 110 ]
def $call_strlen(frame, _, _) = FINISH (UNSUPPORTED frame.STDOUT eps)
  -- otherwise
