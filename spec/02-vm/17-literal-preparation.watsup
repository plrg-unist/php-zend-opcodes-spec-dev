;; Loading a partial call freezes constant argument slots throughout the body.
;; The call itself can be skipped when the unit runs.

syntax prepPoint = PREP_AT nat nat*
syntax prepScope = UNREACHED | REACHED nat*
syntax prepMap = { SCOPES prepScope* }
syntax prepSend = SENT nat nat nat
syntax prepLog = { SENDS prepSend*, FROZEN nat* }
dec $prep_roots(tryregion*) : nat*
dec $prep_never(namedBody*) : bytes*
dec $prep_successors(instruction*, poolentry*, nat, nat*, bytes*) : nat*

dec $prep_after(instruction, nat, nat*) : nat*
def $prep_after(OPLINE opcode _ _ _ _ _ _ _ _ _ _, n, n_stack*) = n :: n_stack*
  -- if opcode <- [INIT_FCALL, INIT_FCALL_BY_NAME, INIT_NS_FCALL_BY_NAME, INIT_DYNAMIC_CALL,
      INIT_METHOD_CALL, INIT_STATIC_METHOD_CALL, INIT_PARENT_PROPERTY_HOOK_CALL, INIT_USER_CALL, NEW]
def $prep_after(OPLINE opcode _ _ _ _ _ _ _ _ _ _, _, _ :: n_stack*) = n_stack*
  -- if opcode <- [DO_ICALL, DO_UCALL, DO_FCALL, DO_FCALL_BY_NAME, CALLABLE_CONVERT, CALLABLE_CONVERT_PARTIAL]
def $prep_after(_, _, n_stack*) = n_stack* -- otherwise

dec $prep_unseen(instruction) : prepScope
def $prep_unseen(_) = UNREACHED

dec $prep_paths(instruction*, poolentry*, bytes*, prepPoint*, prepMap) : prepMap
def $prep_paths(_, _, _, eps, prepMap) = prepMap
def $prep_paths(instruction*, poolentry*, bytes_never*, (PREP_AT n_pc n_stack*) :: prepPoint*, prepMap) =
  $prep_paths(instruction*, poolentry*, bytes_never*, (PREP_AT n_next n_after*)* ++ prepPoint*,
    prepMap[.SCOPES[n_pc] = REACHED n_stack*])
  -- if prepMap.SCOPES[n_pc] = UNREACHED
  -- if n_after* = $prep_after(instruction*[n_pc], n_pc, n_stack*)
  -- if n_next* = $prep_successors(instruction*, poolentry*, n_pc, n_stack*, bytes_never*)
def $prep_paths(instruction*, poolentry*, bytes_never*, (PREP_AT n_pc _) :: prepPoint*, prepMap) =
  $prep_paths(instruction*, poolentry*, bytes_never*, prepPoint*, prepMap)
  -- if prepMap.SCOPES[n_pc] =/= UNREACHED

dec $prep_active(prepScope, nat*) : nat*
def $prep_active(REACHED n_stack*, _) = n_stack*
def $prep_active(UNREACHED, n_stack*) = n_stack*

dec $prep_array(zval) : bool
def $prep_array(ARRAY _ _ _ _) = true
def $prep_array(SHARED_ARRAY _ _) = true
def $prep_array(_) = false -- otherwise

dec $prep_send(instruction, poolentry*) : (nat, nat)?
def $prep_send(OPLINE opcode _ (LIT n_lit) (IMM n_arg) _ _ _ _ _ _ _, poolentry*) = (n_lit, n_arg)
  -- if opcode <- [SEND_VAL, SEND_VAL_EX, SEND_USER]
  -- if $(0 < n_arg) /\ $(n_arg <= 32)
  -- if LITERAL zval = poolentry*[n_lit]
  -- if $prep_array(zval)
def $prep_send(_, _) = eps -- otherwise

;; Equal named-placeholder pool indices share one mask. Each partial writes
;; the slot before loading finishes, including a zero for an omitted mask.
dec $prep_named_write(instruction, nat, nat) : nat
def $prep_named_write(OPLINE CALLABLE_CONVERT_PARTIAL _ _ (LIT n_lit) _ _ _ _ n? _ _, n_lit, _) =
  $raw_pointer(n?)
def $prep_named_write(_, _, n_mask) = n_mask -- otherwise

dec $prep_named_mask(instruction*, nat, nat) : nat
def $prep_named_mask(eps, _, n_mask) = n_mask
def $prep_named_mask(instruction_head :: instruction*, n_lit, n_mask) =
  $prep_named_mask(instruction*, n_lit, $prep_named_write(instruction_head, n_lit, n_mask))

dec $prep_mask(instruction, instruction*) : nat
def $prep_mask(OPLINE CALLABLE_CONVERT_PARTIAL _ _ (IMM n_mask) _ _ _ _ _ _ _, _) = n_mask
def $prep_mask(OPLINE CALLABLE_CONVERT_PARTIAL _ _ (LIT n_lit) _ _ _ _ _ _ _, instruction*) =
  $prep_named_mask(instruction*, n_lit, 0)
def $prep_mask(_, _) = 0 -- otherwise

dec $prep_masked(prepSend, nat, nat) : nat*
def $prep_masked(SENT n_init n_lit n_arg, n_init, n_mask) = [n_lit]
  -- if $($shr(n_mask, n_arg - 1) \ 2 = 1)
def $prep_masked(_, _, _) = eps -- otherwise

dec $prep_bound(prepSend*, nat, nat) : nat*
def $prep_bound(eps, _, _) = eps
def $prep_bound(prepSend_head :: prepSend*, n_init, n_mask) =
  $prep_masked(prepSend_head, n_init, n_mask) ++ $prep_bound(prepSend*, n_init, n_mask)

dec $prep_record(instruction*, poolentry*, nat, nat*, prepLog) : prepLog
def $prep_record(instruction*, poolentry*, n_pc, n_init :: n_stack*, prepLog) =
  prepLog[.SENDS = SENT n_init n_lit n_arg :: prepLog.SENDS]
  -- if $(n_init < n_pc)
  -- if (n_lit, n_arg) = $prep_send(instruction*[n_pc], poolentry*)
def $prep_record(instruction*, _, n_pc, n_init :: n_stack*, prepLog) =
  prepLog[.FROZEN = $prep_bound(prepLog.SENDS, n_init, n_mask) ++ prepLog.FROZEN]
  -- if n_mask = $prep_mask(instruction*[n_pc], instruction*)
  -- if $(n_mask > 0)
def $prep_record(_, _, _, _, prepLog) = prepLog -- otherwise

;; The loader assigns dead instructions the lexical call stack immediately
;; preceding them. Reachable instructions always retain their own path's stack.
dec $prep_scan(instruction*, poolentry*, nat, prepScope*, nat*, prepLog) : nat*
def $prep_scan(_, _, _, eps, _, prepLog) = prepLog.FROZEN
def $prep_scan(instruction*, poolentry*, n_pc, prepScope_head :: prepScope*, n_stack*, prepLog) =
  $prep_scan(instruction*, poolentry*, $(n_pc + 1), prepScope*, $prep_after(instruction*[n_pc], n_pc, n_active*),
    $prep_record(instruction*, poolentry*, n_pc, n_active*, prepLog))
  -- if n_active* = $prep_active(prepScope_head, n_stack*)

def $prepared_literals(instruction*, poolentry*, tryregion*, namedBody*) = n_frozen*
  -- if true <- ($($prep_mask(instruction, instruction*) > 0))*
  -- if true <- ($prep_send(instruction, poolentry*) =/= eps)*
  -- if n_start* = $prep_roots(tryregion*)
  -- if prepMap = $prep_paths(instruction*, poolentry*, $prep_never(namedBody*), (PREP_AT n_start eps)*,
      { SCOPES ($prep_unseen(instruction))* })
  -- if n_frozen* = $prep_scan(instruction*, poolentry*, 0, prepMap.SCOPES, eps, { SENDS eps, FROZEN eps })
def $prepared_literals(_, _, _, _) = eps -- otherwise

;; Method target resolution changes the call paths in units with active classes.
dec $valid_literal_preparation(unit, body) : bool
def $valid_literal_preparation(UNIT _ _ _ _ namedBody* classDecl*, BODY _ _ poolentry* tryregion* _ _ instruction*) =
  ~(false <- ($freezable_literal(zval))*)
  -- if ~(false <- ($dormant_class(classDecl))*)
  -- if n_frozen* = $prepared_literals(instruction*, poolentry*, tryregion*, namedBody*)
  -- if (LITERAL zval = poolentry*[n_frozen])*
def $valid_literal_preparation(_, _) = true -- otherwise

;; Reachability and nonreturning calls.
dec $prep_nonzero(nat) : nat*
def $prep_nonzero(0) = eps
def $prep_nonzero(n) = [n] -- if $(n > 0)

def $prep_roots(eps) = [0]
def $prep_roots((TRY _ n_catch n_finally _) :: tryregion*) =
  $prep_nonzero(n_catch) ++ $prep_nonzero(n_finally) ++ $prep_roots(tryregion*)

dec $prep_type_mask(ztype) : nat
def $prep_type_mask(MASK n) = n
def $prep_type_mask(NAMED n _) = n
def $prep_type_mask(UNION n _) = n
def $prep_type_mask(INTERSECTION n _) = n

;; Function-table keys are exact. The fixed CLI's nonreturning builtins are exit and die.
dec $prep_never_name(namedBody) : bytes*
def $prep_never_name(NAMEDBODY bytes (BODY (BODYDECL _ _ _ _ _ (ARGS _ _ ztype _) _) _ _ _ _ _ _)) = [bytes]
  -- if $(($prep_type_mask(ztype) / 131072) \ 2 = 1)
def $prep_never_name(_) = eps -- otherwise

def $prep_never(eps) = [ [101, 120, 105, 116], [100, 105, 101] ]
def $prep_never(namedBody_head :: namedBody*) = $prep_never_name(namedBody_head) ++ $prep_never(namedBody*)

dec $prep_nonreturn(instruction*, poolentry*, opcode, nat*, bytes*) : bool
def $prep_nonreturn(instruction*, poolentry*, opcode, n_init :: _, bytes_never*) = bytes <- bytes_never*
  -- if opcode <- [DO_ICALL, DO_UCALL]
  -- if OPLINE INIT_FCALL _ _ (LIT n_name) _ _ _ _ _ _ _ = instruction*[n_init]
  -- if LITERAL (STRING bytes) = poolentry*[n_name]
def $prep_nonreturn(_, _, _, _, _) = false -- otherwise

dec $prep_jump(operand, operand, extension?) : nat*
def $prep_jump(TARGET n, _, _) = [n]
def $prep_jump(_, TARGET n, _) = [n]
def $prep_jump(_, _, EXT_TARGET n) = [n]
def $prep_jump(_, _, _) = eps -- otherwise

dec $prep_table(opcode, operand, poolentry*) : nat*
def $prep_table(opcode, LIT n, poolentry*) = n_target*
  -- if opcode <- [SWITCH_LONG, SWITCH_STRING, MATCH]
  -- if LITERAL (ARRAY (ENTRY _ (INT n_target))* _ _ _) = poolentry*[n]
def $prep_table(_, _, _) = eps -- otherwise

dec $prep_fallthrough(opcode, nat, nat) : nat*
def $prep_fallthrough(opcode, n_pc, n_end) = [$(n_pc + 1)]
  -- if ~(opcode <- [JMP, MATCH]) /\ $(n_pc + 1 < n_end)
def $prep_fallthrough(_, _, _) = eps -- otherwise

dec $prep_edges(bool, opcode, operand, operand, extension?, poolentry*, nat, nat) : nat*
def $prep_edges(true, _, _, _, _, _, _, _) = eps
def $prep_edges(false, opcode, operand_a, operand_b, extension?, poolentry*, n_pc, n_end) =
  $prep_jump(operand_a, operand_b, extension?) ++ $prep_table(opcode, operand_b, poolentry*) ++
  $prep_fallthrough(opcode, n_pc, n_end)

def $prep_successors(instruction*, poolentry*, n_pc, n_init*, bytes_never*) =
  $prep_edges(b, opcode, operand_a, operand_b, extension?, poolentry*, n_pc, |instruction*|)
  -- if OPLINE opcode _ operand_a operand_b _ extension? _ _ _ _ _ = instruction*[n_pc]
  -- if b = ((opcode <- [THROW, MATCH_ERROR, VERIFY_NEVER_TYPE, RETURN, RETURN_BY_REF, GENERATOR_RETURN, FAST_RET])
            \/ $prep_nonreturn(instruction*, poolentry*, opcode, n_init*, bytes_never*))
