;; The main symbol table maps byte names to CV or dynamic storage slots. CV
;; rows remain attached while undefined. Removing a dynamic row frees its slot's value.
;; MISSING is the shared null address returned by FETCH_UNSET for an absent name.
dec $symbol_rows(frame) : symbolRow*
def $symbol_rows(frame) = (SYMBOL bytes n)*
  -- if ARRAY_VALUE _ (ITEM (KEY bytes) (INT n))* _ _ = frame.SYMBOLS

dec $symbol_capacity(frame) : nat
def $symbol_capacity(frame) = n
  -- if ARRAY_VALUE _ _ (STORAGE _ (MIXED n _) _) _ = frame.SYMBOLS

dec $symbol_slot(frame, bytes) : nat?
def $symbol_slot(frame, bytes) = n
  -- if INT n = $array_find($stored_entries(frame.SYMBOLS), KEY bytes)
def $symbol_slot(_, _) = eps -- otherwise

dec $symbol_row(frame, bytes, nat) : frame
def $symbol_row(frame, bytes, n) = frame[.SYMBOLS = $store_bucket(frame.SYMBOLS, KEY bytes, INT n)]

dec $append_symbol(frame, bytes, slotValue) : (frame, nat)
def $append_symbol(frame, bytes, slotValue) = (frame'[.SLOTS = frame.SLOTS ++ [$owned(slotValue)]], n)
  -- if n = |frame.SLOTS|
  -- if frame' = $symbol_row(frame, bytes, n)

dec $ensure_symbol(frame, bytes) : (frame, nat)
def $ensure_symbol(frame, bytes) = (frame, n)
  -- if n = $symbol_slot(frame, bytes)
def $ensure_symbol(frame, bytes) = $append_symbol(frame, bytes, NULL)
  -- if $symbol_slot(frame, bytes) = eps

dec $unset_symbol(frame, bytes) : frame
def $unset_symbol(frame, bytes) = $write(frame, CV n, UNDEF)
  -- if n = $symbol_slot(frame, bytes)
  -- if $(n < |frame.NAMES|)
def $unset_symbol(frame, bytes) = $write(frame[.SYMBOLS = $array_remove(frame.SYMBOLS, KEY bytes)], CV n, UNDEF)
  -- if n = $symbol_slot(frame, bytes)
  -- if $(n >= |frame.NAMES|)
def $unset_symbol(frame, _) = frame -- otherwise

dec $seed_symbol(frame, bytes, nat) : frame
def $seed_symbol(frame, bytes, n) = $write($symbol_row(frame, bytes, n), CV n, $initial_global(bytes, frame.SCRIPT))
  -- if $(n < |frame.NAMES|)
def $seed_symbol(frame, bytes, n) = frame'
  -- if n = |frame.NAMES|
  -- if (frame', _) = $append_symbol(frame, bytes, $initial_global(bytes, frame.SCRIPT))

dec $seed_symbols(frame, bytes*) : frame
def $seed_symbols(frame, bytes :: bytes_rest*) = $seed_symbols($seed_symbol(frame, bytes, n), bytes_rest*)
  -- if bytes_cv* = frame.NAMES
  -- if b* = (bytes_cv =/= bytes)*
  -- if n = $prefix_end(b*, 0, |b*|)
def $seed_symbols(frame, eps) = frame

dec $attach_symbols(frame, bytes*, nat) : frame
def $attach_symbols(frame, bytes :: bytes_rest*, n) = $attach_symbols($symbol_row(frame, bytes, n), bytes_rest*, $(n + 1))
def $attach_symbols(frame, eps, _) = frame

def $start_symbols(frame, bytes_auto*) = $attach_symbols($seed_symbols(frame, $global_names(bytes_auto*)), frame.NAMES, 0)

def $bind_global(frame, operand, bytes) = $bind(frame'', operand, slotValue_ref)
  -- if (frame', n) = $ensure_symbol(frame, bytes)
  -- if (frame'', slotValue_ref) = $as_reference(frame', CV n)
