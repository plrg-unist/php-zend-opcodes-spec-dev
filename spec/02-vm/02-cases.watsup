;; A table shared with an ordinary literal operand exposes the signed byte
;; offsets in Zend's relocated array. The pinned ABI uses 32 bytes per opline.
dec $uses_dispatch_table(nat, instruction) : bool
def $uses_dispatch_table(n, OPLINE opcode _ _ (LIT n_table) _ _ _ _ _ _ _) =
  (n = n_table) /\ (opcode <- [ SWITCH_LONG, SWITCH_STRING, MATCH ])
def $uses_dispatch_table(_, _) = false
  -- otherwise

dec $ordinary_array(zval, nat, nat, nat) : slotValue
def $ordinary_array(zval, n_lit, n_end, n_end) = $runtime_value(zval, POOL_LITERAL n_lit, eps)
def $ordinary_array(ARRAY (ENTRY arraykey (INT i_target))* i_next? literalCursor? literalLayout?, n_lit, n_owner, n_end) =
  $runtime_value(ARRAY (ENTRY arraykey (INT $((i_target - n_owner) * 32)))* i_next? literalCursor? literalLayout?, POOL_LITERAL n_lit, eps)
  -- if $(n_owner < n_end)

def $literal_value(ARRAY arrayentry* i? literalCursor? literalLayout?, n_lit, instruction*) =
  $ordinary_array(ARRAY arrayentry* i? literalCursor? literalLayout?, n_lit, n_owner, |instruction*|)
  -- if b* = (~$uses_dispatch_table(n_lit, instruction))*
  -- if n_owner = $prefix_end(b*, 0, |instruction*|)
def $literal_value(SHARED_ARRAY n zval, n_lit, _) = $runtime_value(SHARED_ARRAY n zval, POOL_LITERAL n_lit, eps)
def $literal_value(zval, _, _) = zval
  -- otherwise

;; Table entries hold validated absolute instruction indices. Search exact keys,
;; including integer-looking byte strings, and use the default index on a miss.
dec $table_target(arraykey, zval, nat) : nat
def $table_target(arraykey, ARRAY (ENTRY arraykey_row (INT n_row))* _ _ _, n_default) =
  (n_row* ++ [n_default])[n_position]
  -- if b* = (arraykey =/= arraykey_row)*
  -- if n_position = $prefix_end(b*, 0, |b*|)

dec $dispatch_key(opcode, slotValue) : arraykey?
def $dispatch_key(opcode, INT i) = INDEX i
  -- if opcode = SWITCH_LONG \/ opcode = MATCH
def $dispatch_key(opcode, STRING bytes) = KEY bytes
  -- if opcode = SWITCH_STRING \/ opcode = MATCH
def $dispatch_key(_, _) = eps
  -- otherwise

;; Switch leaves an undefined CV for its following loose comparison chain.
;; Match reads it here, producing the ordinary warning before the default arm.
dec $dispatch_subject(frame, opcode, operand) : (frame, slotValue)
def $dispatch_subject(frame, MATCH, operand) = $read_operand(frame, operand)
def $dispatch_subject(frame, opcode, operand) = (frame, $read(frame, operand))
  -- if opcode =/= MATCH

dec $table_branch(frame, opcode, operand, nat, arraykey?) : frame
def $table_branch(frame, _, LIT n, n_default, arraykey) =
  frame[.PC = $table_target(arraykey, zval, n_default)]
  -- if LITERAL zval = frame.POOL[n]
def $table_branch(frame, MATCH, _, n_default, eps) = frame[.PC = n_default]
def $table_branch(frame, opcode, _, _, eps) = frame
  -- if opcode =/= MATCH

dec $case_comparison(opcode) : opcode
def $case_comparison(CASE) = IS_EQUAL
def $case_comparison(CASE_STRICT) = IS_IDENTICAL

def $dispatch_step(frame, opcode, operand_r, operand_l, operand_h, _, smartbranch?) =
  $apply_numeric(frame', operand_r, UNUSED, smartbranch?,
                 $operate(COMPARISON, $case_comparison(opcode), slotValue_l, slotValue_h, frame'))
  -- if opcode = CASE \/ opcode = CASE_STRICT
  -- if (frame', slotValue_l, slotValue_h) = $binary_inputs(frame, opcode, operand_l, operand_h)
def $dispatch_step(frame, opcode, _, operand_subject, operand_table, EXT_TARGET n_default, _) =
  CONTINUE $table_branch(frame', opcode, operand_table, n_default, $dispatch_key(opcode, slotValue))
  -- if (frame', slotValue) = $dispatch_subject(frame, opcode, operand_subject)
