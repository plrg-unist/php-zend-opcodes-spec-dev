;; The CLI activates _SERVER before the compilation unit is loaded.
dec $lazy_global_names(bytes*) : bytes*
def $lazy_global_names(eps) = eps
def $lazy_global_names([95, 83, 69, 82, 86, 69, 82] :: bytes*) = $lazy_global_names(bytes*)
def $lazy_global_names(bytes_name :: bytes*) = bytes_name :: $lazy_global_names(bytes*)
  -- if bytes_name =/= [95, 83, 69, 82, 86, 69, 82]

;; argv and argc precede registration of the request arrays.
def $global_names(bytes*) =
  [ [97, 114, 103, 118], [97, 114, 103, 99],
    [95, 71, 69, 84], [95, 80, 79, 83, 84], [95, 67, 79, 79, 75, 73, 69],
    [95, 70, 73, 76, 69, 83], [95, 83, 69, 82, 86, 69, 82] ] ++ $lazy_global_names(bytes*)

def $initial_global([97, 114, 103, 118], bytes_script) = $cli_argv(bytes_script) ;; argv
def $initial_global([97, 114, 103, 99], _) = INT 1 ;; argc
def $initial_global([95, 83, 69, 82, 86, 69, 82], _) = CLI_ARRAY ;; _SERVER
def $initial_global([95, 69, 78, 86], _) = CLI_ENV ;; _ENV
def $initial_global([95, 71, 69, 84], _) = ARRAY_VALUE (CLI_ARRAY_ID 0) eps eps eps ;; _GET
def $initial_global([95, 80, 79, 83, 84], _) = ARRAY_VALUE (CLI_ARRAY_ID 4) eps eps eps ;; _POST
def $initial_global([95, 67, 79, 79, 75, 73, 69], _) = ARRAY_VALUE (CLI_ARRAY_ID 5) eps eps eps ;; _COOKIE
def $initial_global([95, 70, 73, 76, 69, 83], _) = ARRAY_VALUE (CLI_ARRAY_ID 6) eps eps eps ;; _FILES
def $initial_global([95, 82, 69, 81, 85, 69, 83, 84], _) = ARRAY_VALUE (CLI_ARRAY_ID 7) eps eps eps ;; _REQUEST

dec $snapshot_entries(frame, runtimeEntry*) : runtimeEntry*
def $snapshot_entries(_, eps) = eps
def $snapshot_entries(frame, (ITEM _ UNDEF) :: runtimeEntry*) = $snapshot_entries(frame, runtimeEntry*)
def $snapshot_entries(frame, (ITEM arraykey slotValue) :: runtimeEntry*) =
  (ITEM arraykey ($copy_array_entry(frame, eps, slotValue))) :: $snapshot_entries(frame, runtimeEntry*)
  -- if slotValue =/= UNDEF

;; Numeric names select Zend's conversion path even when an attached CV is undefined.
dec $snapshot_integer_key(arraykey) : bool
def $snapshot_integer_key(INDEX _) = true
def $snapshot_integer_key(KEY _) = false

dec $snapshot_index(nat, runtimeEntry*, runtimeEntry*) : arrayIndex
def $snapshot_index(_, eps, _) = STORAGE (-9223372036854775808) (VACANT 8)
def $snapshot_index(n_capacity, (ITEM arraykey _)*, _) =
  STORAGE (-9223372036854775808) (MIXED n_capacity eps)
  -- if $(|arraykey*| > 0)
  -- if ~(true <- ($snapshot_integer_key(arraykey))*)
def $snapshot_index(_, (ITEM arraykey _)*, runtimeEntry_visible*) =
  STORAGE ($array_next(runtimeEntry_visible*, eps)) ($replay_layout(VACANT n_capacity, 0, 0, runtimeEntry_visible*))
  -- if true <- ($snapshot_integer_key(arraykey))*
  -- if n_capacity = $array_capacity(|arraykey*|, 8)

def $fetch_globals(frame, operand_r) =
  CONTINUE $write(frame[.NEXTARRAY = $(frame.NEXTARRAY + 1)], operand_r,
    ARRAY_VALUE (FRESH_ARRAY frame.NEXTARRAY) runtimeEntry_visible* ($snapshot_index($symbol_capacity(frame), runtimeEntry*, runtimeEntry_visible*)) eps)
  -- if (SYMBOL bytes n)* = $symbol_rows(frame)
  -- if runtimeEntry* = (ITEM ($array_key_tag($string_array_key(bytes))) ($raw_read(frame, CV n)))*
  -- if runtimeEntry_visible* = $snapshot_entries(frame, runtimeEntry*)
