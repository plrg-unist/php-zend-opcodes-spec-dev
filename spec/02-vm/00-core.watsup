syntax outcome = PHP bytes bytes nat | UNSUPPORTED bytes bytes
syntax fragment = FRAGMENT nat nat bytes
syntax iteratorPosition = ITER_AT arrayId nat
syntax foreachIterator = SNAPSHOT nat nat | LIVE nat iteratorPosition iteratorPosition*
syntax symbolRow = SYMBOL bytes nat
syntax frameSlot = { VALUE slotValue, OWNS bool }
dec $owned(slotValue) : frameSlot
def $owned(slotValue) = { VALUE slotValue, OWNS true }
syntax frame = {
  CODE instruction*, OPLINESIZE nat, POOL poolentry*, PC nat, SLOTS frameSlot*, ROPEPARTS fragment*, NEXTARRAY nat, BORROWED borrowedTable*,
  CELLS slotValue*, ITERATORS foreachIterator*, FILE bytes, SCRIPT bytes, LINE nat, NAMES bytes*, SYMBOLS slotValue, MISSING nat,
  PREDEFINED predefinedConstants, CONSTANTS runtimeEntry*, CONSTCACHE runtimeEntry*, STRICT bool, TRIES tryregion*, STDOUT bytes
}
syntax transition = CONTINUE frame | FINISH outcome

dec $global_names(bytes*) : bytes*
dec $initial_global(bytes, bytes) : slotValue
dec $initial_constants(bytes, nat?) : runtimeEntry*
dec $start_symbols(frame, bytes*) : frame
dec $bind_global(frame, operand, bytes) : frame

dec $empty_slots(nat) : slotValue*
def $empty_slots(0) = eps
def $empty_slots(n) = UNDEF :: $empty_slots(n')
  -- if $(n > 0)
  -- if n' = $(n - 1)

dec $ext_value(extension?) : nat
def $ext_value(eps) = 0
def $ext_value(EXT_VALUE n) = n

;; Each literal table carries its own immutability. Unlabelled nested arrays share a root and have distinct key paths.
;; A shared literal starts a new root wherever the unit names it.
dec $runtime_value(zval, literalRoot, arraykey*) : slotValue
def $runtime_value(ARRAY (ENTRY arraykey zval)* i? literalCursor? literalLayout? b_immutable, literalRoot, arraykey_path*) =
  ARRAY_VALUE (LITERAL_ARRAY literalRoot arraykey_path*) runtimeEntry* (STORAGE ($array_next(runtimeEntry*, i?)) arrayLayout b_immutable)
    ($literal_pointer(arrayLayout, runtimeEntry*, literalCursor?))
  -- if runtimeEntry* = (ITEM arraykey $runtime_value(zval, literalRoot, arraykey_path* ++ [arraykey]))*
  -- if arrayLayout = $literal_layout(runtimeEntry*, literalLayout?)
def $runtime_value(SHARED_ARRAY n zval, _, _) = $runtime_value(zval, SHARED_LITERAL n, eps)
def $runtime_value(zval, _, _) = zval
  -- otherwise

dec $literal_value(zval, nat, instruction*, nat) : slotValue
dec $deref(frame, slotValue) : slotValue
dec $bind(frame, operand, slotValue) : frame
dec $as_reference(frame, operand) : (frame, slotValue)
dec $new_reference(frame, slotValue) : (frame, slotValue)
dec $set_cell(frame, nat, slotValue) : frame
dec $shared_reference(frame, nat) : bool
dec $dup_array(frame, slotValue, arrayId) : slotValue
dec $iterator_update(frame, slotValue, slotValue) : frame
dec $assign(frame, operand, slotValue) : frame
dec $assign_array(frame, operand, slotValue) : frame
dec $shared_array(frame, slotValue) : bool
dec $separate_array(frame, operand, slotValue) : (frame, slotValue)
dec $release(frame, operand, operand) : frame
dec $server_fresh(frame, slotValue, arrayId?) : (frame, slotValue)
dec $server_separate(frame, operand, slotValue) : (frame, slotValue)

;; CV, TMP and VAR indices address the same frame.
dec $address_value(frame, slotValue) : slotValue
def $address_value(frame, SYMBOL_LOCATION n) = frame.SLOTS[n].VALUE
def $address_value(_, slotValue) = slotValue -- otherwise
dec $slot_value(frame, nat) : slotValue
def $slot_value(frame, n) = $current(frame.BORROWED, $address_value(frame, frame.SLOTS[n].VALUE))
dec $raw_read(frame, operand) : slotValue
def $raw_read(frame, LIT n) = $literal_value(zval, n, frame.CODE, frame.OPLINESIZE)
  -- if LITERAL zval = frame.POOL[n]
def $raw_read(frame, CV n) = $slot_value(frame, n)
def $raw_read(frame, TMP n) = $slot_value(frame, n)
def $raw_read(frame, VAR n) = $slot_value(frame, n)

dec $read(frame, operand) : slotValue
def $read(frame, operand) = $cell_value(frame.BORROWED, frame.CELLS, $raw_read(frame, operand))

;; TMP assignment transfers the stored zval, including a reference made by MAKE_REF.
dec $copy_value(frame, operand, slotValue) : slotValue
def $copy_value(frame, TMP n, _) = $raw_read(frame, TMP n)
def $copy_value(_, _, slotValue) = slotValue -- otherwise

dec $temporary_value(frame, operand) : slotValue
def $temporary_value(frame, TMP n) = frame.SLOTS[n].VALUE
def $temporary_value(frame, VAR n) = frame.SLOTS[n].VALUE

dec $write(frame, operand, slotValue) : frame
def $write(frame, UNUSED, _) = frame
def $write(frame, CV n, slotValue) = frame[.SLOTS[n] = $owned(slotValue)]
def $write(frame, TMP n, slotValue) = frame[.SLOTS[n] = $owned(slotValue)]
def $write(frame, VAR n, slotValue) = frame[.SLOTS[n] = $owned(slotValue)]

syntax severity = NOTICE | WARNING | DEPRECATED | FATAL
dec $severity_label(severity) : bytes
def $severity_label(NOTICE) = [ 78, 111, 116, 105, 99, 101 ]
def $severity_label(WARNING) = [ 87, 97, 114, 110, 105, 110, 103 ]
def $severity_label(DEPRECATED) = [ 68, 101, 112, 114, 101, 99, 97, 116, 101, 100 ]
def $severity_label(FATAL) = [ 70, 97, 116, 97, 108, 32, 101, 114, 114, 111, 114 ]

;; Pinned CLI display_errors=1 writes the default diagnostic to stdout.
dec $report(frame, severity, bytes) : frame
def $report(frame, severity, bytes_msg) = frame[.STDOUT = frame.STDOUT ++ [10]
    ++ $severity_label(severity) ++ [ 58, 32 ] ++ bytes_msg ++ [ 32, 105, 110, 32 ] ++ frame.FILE
    ++ [ 32, 111, 110, 32, 108, 105, 110, 101, 32 ] ++ $digits(frame.LINE) ++ [10]]

;; An ordinary read warns, supplies null, and leaves an undefined CV undefined.
;; Warning: Undefined variable $<name>
dec $read_value(frame, operand, slotValue) : (frame, slotValue)
def $read_value(frame, CV n, UNDEF) = ($report(frame, WARNING,
      [ 85, 110, 100, 101, 102, 105, 110, 101, 100, 32, 118, 97, 114, 105, 97, 98, 108, 101,
        32, 36 ] ++ frame.NAMES[n]), NULL)
def $read_value(frame, _, slotValue) = (frame, slotValue)
  -- otherwise

dec $read_operand(frame, operand) : (frame, slotValue)
def $read_operand(frame, operand) = $read_value(frame, operand, $read(frame, operand))

;; Warning: unexpected NAN value was coerced to <type>
dec $nan_frame(frame, slotValue, bytes) : frame
def $nan_frame(frame, slotValue, bytes_type) = $report(frame, WARNING,
      [ 117, 110, 101, 120, 112, 101, 99, 116, 101, 100, 32, 78, 65, 78, 32, 118, 97, 108,
        117, 101, 32, 119, 97, 115, 32, 99, 111, 101, 114, 99, 101, 100, 32, 116, 111, 32 ] ++ bytes_type)
  -- if $is_nan(slotValue)
def $nan_frame(frame, _, _) = frame
  -- otherwise

dec $truth_frame(frame, slotValue) : frame
def $truth_frame(frame, slotValue) = $nan_frame(frame, slotValue, [ 98, 111, 111, 108 ])

dec $string_frame(frame, slotValue) : frame
;; Array to string conversion
def $string_frame(frame, slotValue) = $report(frame, WARNING,
    [ 65, 114, 114, 97, 121, 32, 116, 111, 32, 115, 116, 114, 105, 110, 103, 32,
      99, 111, 110, 118, 101, 114, 115, 105, 111, 110 ])
  -- if $is_array_value(slotValue)
def $string_frame(frame, slotValue) = $nan_frame(frame, slotValue, [ 115, 116, 114, 105, 110, 103 ])
  -- if ~$is_array_value(slotValue)

;; PC already points to the fallthrough instruction.
dec $branch(frame, opcode, bool, nat) : frame
def $branch(frame, opcode, b, n) = frame[.PC = n]
  -- if (opcode <- [JMPNZ, JMPNZ_EX, JMP_SET]) = b
def $branch(frame, _, _, _) = frame
  -- otherwise

dec $comparison(frame, operand, smartbranch?, bool) : frame
def $comparison(frame, operand, eps, b) = $write(frame, operand, $zend_bool(b))
def $comparison(frame, _, smartbranch, b) = $branch(frame[.PC = $(frame.PC + 1)], opcode, b, n)
  -- if OPLINE opcode _ _ (TARGET n) _ _ _ _ _ _ _ = frame.CODE[frame.PC]

dec $protected(tryregion, nat) : bool
def $protected(TRY n_start n_catch _ n_end, n_pc) =
  $(n_start <= n_pc) /\ ($(n_pc < n_catch) \/ $(n_pc <= n_end))

;; An uncaught exception in main contributes one stack frame. An active handler
;; or finally region requires PHP exception unwinding.
dec $raise(frame, bytes) : transition
def $raise(frame, bytes_exception) = FINISH (PHP frame'.STDOUT eps 255)
  -- if tryregion* = frame.TRIES
  -- if n_pc = $(frame.PC - 1)
  -- if ~(true <- ($protected(tryregion, n_pc))*)
  -- if bytes_msg = [ 85, 110, 99, 97, 117, 103, 104, 116, 32 ] ++ bytes_exception
      ++ [ 32, 105, 110, 32 ] ++ frame.FILE ++ [58] ++ $digits(frame.LINE)
      ++ [ 10, 83, 116, 97, 99, 107, 32, 116, 114, 97, 99, 101, 58, 10, 35, 48, 32, 123,
           109, 97, 105, 110, 125, 10, 32, 32, 116, 104, 114, 111, 119, 110 ]
  -- if frame' = $report(frame, FATAL, bytes_msg)
def $raise(frame, _) = FINISH (UNSUPPORTED frame.STDOUT eps)
  -- otherwise

dec $length_result(frame, operand, slotValue, lengthResult) : transition
def $length_result(frame, operand, slotValue, LENGTH n) = CONTINUE $write($string_frame(frame, slotValue), operand, INT n)
;; strlen(): Passing null to parameter #1 ($string) of type string is deprecated
def $length_result(frame, operand, _, NULL_LENGTH) = CONTINUE $write(frame', operand, INT 0)
  -- if frame' = $report(frame, DEPRECATED,
      [ 115, 116, 114, 108, 101, 110, 40, 41, 58, 32, 80, 97, 115, 115, 105, 110, 103, 32,
        110, 117, 108, 108, 32, 116, 111, 32, 112, 97, 114, 97, 109, 101, 116, 101, 114, 32,
        35, 49, 32, 40, 36, 115, 116, 114, 105, 110, 103, 41, 32, 111, 102, 32, 116, 121,
        112, 101, 32, 115, 116, 114, 105, 110, 103, 32, 105, 115, 32, 100, 101, 112, 114, 101,
        99, 97, 116, 101, 100 ])
;; TypeError: strlen(): Argument #1 ($string) must be of type string, <type> given
def $length_result(frame, _, _, LENGTH_ERROR bytes_type) = $raise(frame, bytes_msg)
  -- if bytes_msg =
      [ 84, 121, 112, 101, 69, 114, 114, 111, 114, 58, 32, 115, 116, 114, 108, 101, 110,
        40, 41, 58, 32, 65, 114, 103, 117, 109, 101,
        110, 116, 32, 35, 49, 32, 40, 36, 115, 116, 114, 105, 110, 103, 41, 32, 109, 117,
        115, 116, 32, 98, 101, 32, 111, 102, 32, 116, 121, 112, 101, 32, 115, 116, 114, 105,
        110, 103, 44, 32 ]
      ++ bytes_type ++ [ 32, 103, 105, 118, 101, 110 ]

dec $store_result(frame, operand, operand, slotValue) : transition
def $store_result(frame, operand_r, operand_dst, slotValue) =
  CONTINUE $write($assign(frame, operand_dst, slotValue), operand_r, slotValue)

dec $apply_numeric(frame, operand, operand, smartbranch?, numericResult) : transition
def $apply_numeric(frame, operand_r, operand_dst, eps, NUM_VALUE slotValue) = $store_result(frame, operand_r, operand_dst, slotValue)
def $apply_numeric(frame, operand_r, _, smartbranch, NUM_VALUE slotValue) =
  CONTINUE $comparison(frame, operand_r, smartbranch, slotValue = TRUE)
def $apply_numeric(frame, _, _, _, NUM_ERROR bytes) = $raise(frame, bytes)
def $apply_numeric(frame, operand_r, operand_dst, smartbranch?, NUM_WARNING bytes numericResult) =
  $apply_numeric($report(frame, WARNING, bytes), operand_r, operand_dst, smartbranch?, numericResult)
def $apply_numeric(frame, operand_r, operand_dst, smartbranch?, NUM_DEPRECATED bytes numericResult) =
  $apply_numeric($report(frame, DEPRECATED, bytes), operand_r, operand_dst, smartbranch?, numericResult)
def $apply_numeric(frame, _, _, _, NUM_UNSUPPORTED) = FINISH (UNSUPPORTED frame.STDOUT eps)

dec $post_incdec(frame, operand, operand, slotValue, numericResult) : transition
dec $unary(frame, opcode, operand, operand, operand, slotValue) : transition
def $unary(frame, ASSIGN, operand_r, operand_dst, operand_src, slotValue) =
  $store_result(frame, operand_r, operand_dst, $copy_value(frame, operand_src, slotValue))
  -- if $known_value(slotValue) \/ $host_offset(slotValue)
def $unary(frame, opcode, operand_r, operand_dst, _, slotValue) =
  $apply_numeric(frame, operand_r, operand_dst, eps, $numeric_incdec(opcode, slotValue))
  -- if opcode = PRE_INC \/ opcode = PRE_DEC
  -- if $known_value(slotValue)
def $unary(frame, opcode, operand_r, operand_dst, _, slotValue) =
  $post_incdec(frame, operand_r, operand_dst, slotValue, $numeric_incdec(opcode, slotValue))
  -- if opcode = POST_INC \/ opcode = POST_DEC
  -- if $known_value(slotValue)
def $unary(frame, BW_NOT, operand_r, _, _, slotValue) =
  $apply_numeric(frame, operand_r, UNUSED, eps, $bitwise(BW_NOT, slotValue, NULL))
  -- if $known_value(slotValue)
def $unary(frame, QM_ASSIGN, operand_r, operand_src, _, slotValue) =
  CONTINUE $write(frame, operand_r, $copy_value(frame, operand_src, slotValue))
  -- if $known_value(slotValue) \/ $host_offset(slotValue)
def $unary(frame, FREE, _, _, _, slotValue) = CONTINUE frame
  -- if $known_value(slotValue) \/ $host_offset(slotValue)
def $unary(frame, CHECK_VAR, _, _, _, _) = CONTINUE frame
def $unary(frame, ECHO, _, _, _, slotValue) = CONTINUE frame'[.STDOUT = frame'.STDOUT ++ $scalar_bytes(slotValue)]
  -- if $known_value(slotValue)
  -- if frame' = $string_frame(frame, slotValue)
def $unary(frame, RETURN, _, _, _, slotValue) = FINISH (PHP frame.STDOUT eps 0)
  -- if $known_value(slotValue) \/ $host_offset(slotValue)
def $unary(frame, opcode, operand_r, _, _, slotValue) = CONTINUE $write($truth_frame(frame, slotValue), operand_r, $zend_bool(b))
  -- if opcode = BOOL \/ opcode = BOOL_NOT
  -- if $truth_known(slotValue)
  -- if b = ($truth(slotValue) = (opcode = BOOL))
def $unary(frame, GET_TYPE, operand_r, operand_src, _, slotValue) =
  CONTINUE $write(frame, operand_r, STRING bytes)
  -- if slotValue_type* = $host_type_values($copy_value(frame, operand_src, slotValue))
  -- if bytes :: bytes_rest* = ($gettype(slotValue_type))*
  -- if ~(false <- (bytes = bytes_rest)*)
def $unary(frame, STRLEN, operand_r, operand_src, _, slotValue) =
  $length_result(frame, operand_r, slotValue, LENGTH_ERROR $value_name(slotValue))
  -- if $is_reference($copy_value(frame, operand_src, slotValue))
def $unary(frame, STRLEN, operand_r, operand_src, _, slotValue) = $length_result(frame, operand_r, slotValue, $strlen(slotValue, frame.STRICT))
  -- if $known_value(slotValue)
  -- if ~$is_reference($copy_value(frame, operand_src, slotValue))

dec $xor_result(frame, operand, slotValue, slotValue) : transition
def $xor_result(frame, operand_r, slotValue_l, slotValue_r) =
  CONTINUE $write($truth_frame(frame, slotValue_r), operand_r, $zend_bool(b))
  -- if $truth_known(slotValue_l) /\ $truth_known(slotValue_r)
  -- if b = ($truth(slotValue_l) =/= $truth(slotValue_r))
def $xor_result(frame, operand_r, slotValue, slotValue) = CONTINUE $write(frame, operand_r, FALSE)
  -- if ~$truth_known(slotValue)
def $xor_result(frame, _, _, _) = FINISH (UNSUPPORTED frame.STDOUT eps) -- otherwise

dec $xor(frame, operand, slotValue, slotValue) : transition
def $xor(frame, operand_r, slotValue_l, slotValue_r) =
  $xor_result($truth_frame(frame, slotValue_l), operand_r, slotValue_l, slotValue_r)

dec $operand_rank(operand) : nat
def $operand_rank(LIT _) = 1
def $operand_rank(TMP _) = 2
def $operand_rank(VAR _) = 4
def $operand_rank(CV _) = 8

;; MUL reads its operands in listing order. The instructions below model
;; the operand swap Zend can perform when it installs their handlers.
dec $operand_order(opcode, operand, operand) : (operand, operand)
def $operand_order(opcode, operand_l, operand_h) = (operand_h, operand_l)
  -- if opcode <- [BW_OR, BW_AND, BW_XOR, BOOL_XOR, IS_IDENTICAL, IS_NOT_IDENTICAL, IS_EQUAL, IS_NOT_EQUAL]
  -- if $($operand_rank(operand_l) < $operand_rank(operand_h))
def $operand_order(_, operand_l, operand_h) = (operand_l, operand_h)
  -- otherwise

;; Strict TMP handlers inspect a raw reference or indirect tag. Regular array
;; entries and CV values compare their dereferenced contents.
dec $comparison_input(frame, opcode, operand, slotValue) : slotValue
def $comparison_input(frame, opcode, TMP n, _) = slotValue_raw
  -- if opcode <- [IS_IDENTICAL, IS_NOT_IDENTICAL, CASE_STRICT]
  -- if slotValue_raw = frame.SLOTS[n].VALUE
  -- if $strict_pointer(slotValue_raw)
def $comparison_input(_, _, _, slotValue) = slotValue -- otherwise

dec $binary_inputs(frame, opcode, operand, operand) : (frame, slotValue, slotValue)
def $binary_inputs(frame, opcode, operand_a, operand_b) =
  (frame'', $comparison_input(frame, opcode, operand_l, slotValue_l), $comparison_input(frame', opcode, operand_h, slotValue_h))
  -- if (operand_l, operand_h) = $operand_order(opcode, operand_a, operand_b)
  -- if (frame', slotValue_l) = $read_operand(frame, operand_l)
  -- if (frame'', slotValue_h) = $read_operand(frame', operand_h)

syntax binaryKind = ARITHMETIC | BITWISE | COMPARISON
dec $binary_kind(opcode) : binaryKind?
def $binary_kind(opcode) = ARITHMETIC
  -- if opcode <- [ADD, SUB, MUL, DIV, MOD, POW]
def $binary_kind(opcode) = BITWISE
  -- if opcode <- [SL, SR, BW_OR, BW_AND, BW_XOR]
def $binary_kind(opcode) = COMPARISON
  -- if opcode <- [IS_IDENTICAL, IS_NOT_IDENTICAL, IS_EQUAL, IS_NOT_EQUAL, IS_SMALLER, IS_SMALLER_OR_EQUAL, SPACESHIP]
def $binary_kind(_) = eps
  -- otherwise

dec $operate(binaryKind, opcode, slotValue, slotValue, frame) : numericResult
def $operate(ARITHMETIC, opcode, slotValue_l, slotValue_h, _) = $numeric_binary(opcode, slotValue_l, slotValue_h)
def $operate(BITWISE, opcode, slotValue_l, slotValue_h, _) = $bitwise(opcode, slotValue_l, slotValue_h)
def $operate(COMPARISON, opcode, slotValue_l, slotValue_h, frame) =
  $comparison_result(opcode, $deref_order(comparisonMode, slotValue_l, slotValue_h))
  -- if comparisonMode = { STRICT (opcode <- [IS_IDENTICAL, IS_NOT_IDENTICAL]),
      EQUALITY (opcode <- [IS_IDENTICAL, IS_NOT_IDENTICAL, IS_EQUAL, IS_NOT_EQUAL]),
      SCRIPT frame.SCRIPT, CELLS frame.CELLS, TABLES frame.BORROWED, ACTIVE eps }

dec $binary_operation(frame, bool, opcode, slotValue, slotValue) : (frame, numericResult)
dec $concat_values(frame, bool, slotValue, slotValue) : (frame, numericResult)
dec $dim_compound(frame, nat, slotValue, slotValue) : (frame, numericResult)
dec $compound(frame, operand, operand, operand, nat, slotValue, slotValue) : transition
dec $array_cast(frame, operand, slotValue) : transition

dec $cast(frame, operand, operand, nat, slotValue) : transition
def $cast(frame, operand_r, _, n, slotValue) = $apply_numeric(frame, operand_r, UNUSED, eps, $numeric_cast(n, slotValue))
  -- if n = 4 \/ n = 5
  -- if $known_value(slotValue) /\ $truth_known(slotValue)
def $cast(frame, operand_r, _, 6, slotValue) =
  CONTINUE $write($string_frame(frame, slotValue), operand_r, STRING $scalar_bytes(slotValue))
  -- if $known_value(slotValue)
def $cast(frame, operand_r, operand_src, 7, slotValue) = $array_cast(frame, operand_r, $copy_value(frame, operand_src, slotValue))
  -- if $known_value(slotValue) \/ $nonnull_host(slotValue)
def $cast(frame, _, _, _, _) = FINISH (UNSUPPORTED frame.STDOUT eps)
  -- otherwise

;; TYPE_CHECK tests the raw tag first. Mask bit zero matches an undefined CV
;; without the fetch or warning; otherwise the normal undefined read supplies null.
dec $type_operand(frame, operand, slotValue, nat) : (frame, slotValue)
def $type_operand(frame, CV n, UNDEF, n_mask) = $read_value(frame, CV n, UNDEF)
  -- if $(n_mask \ 2 = 0)
def $type_operand(frame, CV _, REFERENCE n, n_mask) = (frame, $deref(frame, REFERENCE n))
  -- if $((n_mask / 1024) \ 2 = 0)
def $type_operand(frame, _, slotValue, _) = (frame, slotValue)
  -- otherwise

relation StringStep: frame; opcode; operand; operand; operand; extension? ~> transition
  hint(input %0 %1 %2 %3 %4 %5)

dec $truth_branch(frame, opcode, operand, operand, nat, slotValue) : transition
dec $null_branch(frame, opcode, operand, operand, nat, nat, slotValue) : frame
dec $dispatch_step(frame, opcode, operand, operand, operand, extension?, smartbranch?) : transition
dec $array_build_step(frame, opcode, operand, operand, operand, nat) : transition
relation ArrayReadStep: frame; opcode; operand; operand; operand; extension?; smartbranch? ~> transition
  hint(input %0 %1 %2 %3 %4 %5 %6)
dec $dimension_location_step(frame, opcode, operand, operand, operand, nat) : transition
dec $location_input(frame, operand) : bool
dec $defined_dimension_context(frame, operand, operand, nat) : bool
dec $dimension_write_step(frame, opcode, operand, operand, operand, nat) : transition
dec $reference_step(frame, opcode, operand, operand, operand, nat) : transition
dec $foreach_step(frame, opcode, operand, operand, operand, extension?) : transition
dec $foreach_input(frame, opcode, operand) : bool
;; Iteration and destructuring of a scalar can report its type without its bytes.
dec $container_type(slotValue) : slotValue
def $container_type(HOST_OFFSET hostSource) = slotValue
  -- if [slotValue] = $host_type_values(HOST_OFFSET hostSource)
def $container_type(slotValue) = slotValue -- otherwise

dec $named_step(frame, opcode, operand, operand, nat, smartbranch?) : transition
dec $fetch_globals(frame, operand) : transition
dec $constant_step(frame, opcode, operand, operand, operand, extension?, smartbranch?) : transition
relation DestructureStep: frame; operand; operand; operand ~> transition
  hint(input %0 %1 %2 %3)

dec $step(frame, opcode, operand, operand, operand, extension?, smartbranch?) : transition
def $step(frame, NOP, _, _, _, _, _) = CONTINUE frame
def $step(frame, COPY_TMP, operand_r, operand_src, _, _, _) =
  CONTINUE $write(frame, operand_r, $temporary_value(frame, operand_src))
def $step(frame, JMP, _, TARGET n, _, _, _) = CONTINUE frame[.PC = n]
def $step(frame, UNSET_CV, _, operand_a, _, _, _) = CONTINUE $write(frame, operand_a, UNDEF)
def $step(frame, BIND_GLOBAL, _, operand_a, operand_b, _, _) = CONTINUE $bind_global(frame, operand_a, bytes)
  -- if STRING bytes = $raw_read(frame, operand_b)
def $step(frame, FETCH_GLOBALS, operand_r, _, _, _, _) = $fetch_globals(frame, operand_r)
def $step(frame, opcode, operand_r, operand_a, _, extension?, smartbranch?) =
  $named_step(frame, opcode, operand_r, operand_a, $ext_value(extension?), smartbranch?)
  -- if opcode <- [FETCH_R, FETCH_W, FETCH_RW, FETCH_IS, FETCH_UNSET, UNSET_VAR, ISSET_ISEMPTY_VAR]
  -- if $known_value($read(frame, operand_a)) \/ $read(frame, operand_a) = UNDEF
def $step(frame, opcode, operand_r, operand_a, operand_b, extension?, smartbranch?) =
  $constant_step(frame, opcode, operand_r, operand_a, operand_b, extension?, smartbranch?)
  -- if opcode <- [DECLARE_CONST, FETCH_CONSTANT, DEFINED]
def $step(frame, opcode, operand_r, operand_a, operand_b, extension?, _) =
  $reference_step(frame, opcode, operand_r, operand_a, operand_b, $ext_value(extension?))
  -- if opcode <- [ASSIGN_REF, MAKE_REF, SEPARATE, FETCH_LIST_W]
def $step(frame, opcode, operand_r, operand_a, operand_b, extension?, _) =
  $foreach_step(frame, opcode, operand_r, operand_a, operand_b, extension?)
  -- if opcode <- [FE_RESET_R, FE_FETCH_R, FE_RESET_RW, FE_FETCH_RW, FE_FREE]
  -- if $foreach_input(frame, opcode, operand_a)
def $step(frame, FETCH_LIST_R, operand_r, operand_a, operand_k, _, _) = transition
  -- DestructureStep: frame; operand_r; operand_a; operand_k ~> transition
def $step(frame, opcode, operand_r, operand_a, operand_k, extension?, _) =
  $dimension_location_step(frame, opcode, operand_r, operand_a, operand_k, $ext_value(extension?))
  -- if opcode <- [FETCH_DIM_W, FETCH_DIM_RW, FETCH_DIM_UNSET]
  -- if $location_input(frame, operand_a)
  -- if $location_input(frame, operand_k) \/ (opcode = FETCH_DIM_UNSET /\ $scalar_type_bit($read(frame, operand_a)) = 64)
  -- if $defined_dimension_context(frame, operand_a, operand_k, $ext_value(extension?))
def $step(frame, opcode, operand_r, operand_a, operand_k, extension?, _) =
  $dimension_write_step(frame, opcode, operand_r, operand_a, operand_k, $ext_value(extension?))
  -- if opcode <- [ASSIGN_DIM, ASSIGN_DIM_OP, UNSET_DIM]
def $step(frame, opcode, operand_r, operand_a, TARGET n, _, _) =
  $truth_branch(frame, opcode, operand_r, operand_a, n, $read(frame, operand_a))
  -- if opcode <- [JMPZ, JMPNZ, JMPZ_EX, JMPNZ_EX, JMP_SET]
def $step(frame, opcode, operand_r, operand_a, TARGET n, extension?, _) =
  CONTINUE $null_branch(frame, opcode, operand_r, operand_a, n, $ext_value(extension?), $copy_value(frame, operand_a, $read(frame, operand_a)))
  -- if opcode = COALESCE \/ opcode = JMP_NULL
def $step(frame, opcode, operand_r, operand_a, operand_b, extension?, smartbranch?) =
  $dispatch_step(frame, opcode, operand_r, operand_a, operand_b, extension?, smartbranch?)
  -- if opcode <- [CASE, CASE_STRICT, SWITCH_LONG, SWITCH_STRING, MATCH]
def $step(frame, opcode, operand_r, operand_a, operand_b, extension?, _) =
  $array_build_step(frame, opcode, operand_r, operand_a, operand_b, $ext_value(extension?))
  -- if opcode <- [INIT_ARRAY, ADD_ARRAY_ELEMENT, ADD_ARRAY_UNPACK]
def $step(frame, opcode, operand_r, operand_a, operand_b, extension?, smartbranch?) = transition
  -- if opcode <- [FETCH_DIM_R, FETCH_DIM_IS, ISSET_ISEMPTY_DIM_OBJ, ISSET_ISEMPTY_CV, COUNT, ARRAY_KEY_EXISTS, IN_ARRAY]
  -- ArrayReadStep: frame; opcode; operand_r; operand_a; operand_b; extension?; smartbranch? ~> transition
def $step(frame, ASSIGN, operand_r, operand_dst, operand_src, _, _) = transition
  -- if (frame', slotValue) = $read_operand(frame, operand_src)
  -- if transition = $unary(frame', ASSIGN, operand_r, operand_dst, operand_src, slotValue)
;; Compound assignment fetches its right operand before the read/write destination.
def $step(frame, ASSIGN_OP, operand_r, operand_dst, operand_src, extension?, _) =
  $compound(frame'', operand_r, operand_dst, operand_src, $ext_value(extension?), slotValue_l, slotValue_h)
  -- if (frame', slotValue_h) = $read_operand(frame, operand_src)
  -- if (frame'', slotValue_l) = $read_operand(frame', operand_dst)
def $step(frame, opcode, operand_r, operand_a, operand_b, _, _) = transition
  -- if opcode <- [PRE_INC, PRE_DEC, POST_INC, POST_DEC, BW_NOT, QM_ASSIGN, FREE, CHECK_VAR,
                   ECHO, RETURN, BOOL, BOOL_NOT, GET_TYPE, STRLEN]
  -- if (frame', slotValue) = $read_operand(frame, operand_a)
  -- if transition = $unary(frame', opcode, operand_r, operand_a, operand_b, slotValue)
def $step(frame, CAST, operand_r, operand_a, _, extension?, _) = $cast(frame', operand_r, operand_a, $ext_value(extension?), slotValue)
  -- if (frame', slotValue) = $read_operand(frame, operand_a)
def $step(frame, BOOL_XOR, operand_r, operand_a, operand_b, _, _) = $xor(frame', operand_r, slotValue_l, slotValue_h)
  -- if (frame', slotValue_l, slotValue_h) = $binary_inputs(frame, BOOL_XOR, operand_a, operand_b)
def $step(frame, opcode, operand_r, operand_a, operand_b, _, smartbranch?) =
  $apply_numeric(frame'', operand_r, UNUSED, smartbranch?, numericResult)
  -- if binaryKind = $binary_kind(opcode)
  -- if (frame', slotValue_l, slotValue_h) = $binary_inputs(frame, opcode, operand_a, operand_b)
  -- if (frame'', numericResult) = $binary_operation(frame', operand_r = operand_a, opcode, slotValue_l, slotValue_h)
def $step(frame, TYPE_CHECK, operand_r, operand_a, _, extension?, smartbranch?) =
  CONTINUE $comparison(frame', operand_r, smartbranch?, b)
  -- if slotValue = $raw_read(frame, operand_a)
  -- if n_mask = $ext_value(extension?)
  -- if (frame', slotValue') = $type_operand(frame, operand_a, slotValue, n_mask)
  -- if slotValue_type* = $host_type_values(slotValue')
  -- if b :: b_rest* = ($type_check(slotValue_type, n_mask))*
  -- if ~(false <- (b = b_rest)*)
def $step(frame, opcode, operand_r, operand_a, operand_b, extension?, _) = transition
  -- if opcode <- [CONCAT, FAST_CONCAT, ROPE_INIT, ROPE_ADD, ROPE_END]
  -- StringStep: frame; opcode; operand_r; operand_a; operand_b; extension? ~> transition
def $step(frame, _, _, _, _, _, _) = FINISH (UNSUPPORTED frame.STDOUT eps)
  -- otherwise

dec $observes_host(frame, opcode, operand, operand) : bool
dec $host_slot(frame, slotValue) : bool
def $host_slot(frame, slotValue) = $host_offset($deref(frame, slotValue)) -- if $strict_pointer(slotValue)
def $host_slot(_, slotValue) = $host_offset(slotValue) -- if ~$strict_pointer(slotValue)
dec $host_operand(frame, operand) : bool
def $host_operand(frame, CV n) = $host_slot(frame, frame.SLOTS[n].VALUE)
def $host_operand(frame, TMP n) = $host_slot(frame, frame.SLOTS[n].VALUE)
def $host_operand(frame, VAR n) = $host_slot(frame, frame.SLOTS[n].VALUE)
def $host_operand(_, _) = false -- otherwise

;; Transfers do not inspect the inherited value. Other handlers listed here
;; check it after fetching their operands in Zend order.
dec $handles_host_input(opcode) : bool
def $handles_host_input(opcode) = ($binary_kind(opcode) =/= eps) \/
  (opcode <- [ASSIGN, ASSIGN_OP, ASSIGN_REF, MAKE_REF, SEPARATE, COPY_TMP, QM_ASSIGN, FREE, FE_FREE, CHECK_VAR, UNSET_CV, CONCAT, FAST_CONCAT,
              RETURN, TYPE_CHECK, GET_TYPE, COUNT, CAST, CASE, CASE_STRICT, ISSET_ISEMPTY_CV, INIT_ARRAY, ADD_ARRAY_ELEMENT, BIND_GLOBAL,
              FE_RESET_R, FE_RESET_RW, FE_FETCH_RW, FETCH_LIST_W, SWITCH_LONG, SWITCH_STRING, MATCH])
dec $host_type_suffices(frame, opcode, operand, operand) : bool
def $host_type_suffices(frame, opcode, operand_a, _) = true
  -- if opcode = COALESCE \/ opcode = JMP_NULL
  -- if $nonnull_host($read(frame, operand_a))
def $host_type_suffices(frame, ARRAY_KEY_EXISTS, _, operand_a) = true
  -- if HOST_OFFSET hostSource = $read(frame, operand_a)
  -- if [slotValue] = $host_type_values(HOST_OFFSET hostSource)
def $host_type_suffices(frame, FETCH_LIST_R, operand_a, _) = true
  -- if slotValue = $container_type($read(frame, operand_a))
  -- if $simple_value(slotValue) \/ slotValue = UNDEF
def $host_type_suffices(frame, UNSET_DIM, operand_a, _) = true
  -- if STRING _ = $read(frame, operand_a)
def $host_type_suffices(_, _, _, _) = false -- otherwise

def $observes_host(frame, opcode, operand_a, operand_b) = ~$host_type_suffices(frame, opcode, operand_a, operand_b)
  -- if ~$handles_host_input(opcode)
  -- if $host_operand(frame, operand_a) \/ (~(opcode <- [FE_FETCH_R, FE_FETCH_RW]) /\ $host_operand(frame, operand_b))
def $observes_host(_, _, _, _) = false -- otherwise

dec $checked_step(frame, opcode, operand, operand, operand, extension?, smartbranch?) : transition
def $checked_step(frame, opcode, _, operand_a, operand_b, _, _) = FINISH (UNSUPPORTED frame.STDOUT eps)
  -- if $observes_host(frame, opcode, operand_a, operand_b)
def $checked_step(frame, opcode, operand_r, operand_a, operand_b, extension?, smartbranch?) =
  $step(frame, opcode, operand_r, operand_a, operand_b, extension?, smartbranch?)
  -- if ~$observes_host(frame, opcode, operand_a, operand_b)

dec $run(frame) : outcome
dec $resume(transition) : outcome
dec $release_inputs(transition, opcode, operand, operand, operand) : transition
def $resume(CONTINUE frame) = $run(frame)
def $resume(FINISH outcome) = outcome
def $run(frame) = $resume($release_inputs(transition, opcode, operand_r, operand_a, operand_b))
  -- if OPLINE opcode operand_r operand_a operand_b n extension? _ _ _ smartbranch? _ = frame.CODE[frame.PC]
  -- if transition = $checked_step(frame[.PC = $(frame.PC + 1)][.LINE = n], opcode, operand_r, operand_a, operand_b, extension?, smartbranch?)

;; Conditional and anonymous classes have a NUL in their table key. Loading
;; members can already emit diagnostics before the declaration opline runs.
dec $dormant_class(classDecl) : bool
def $dormant_class(CLASS (CLASSHEADER bytes_key _ classLink _ _ _ bytes_parent? _)
                      eps eps eps (TRAITS eps eps eps) eps eps eps)
  = (0 <- bytes_key) /\ ((classLink = UNLINKED) \/ (bytes_parent? = eps))
def $dormant_class(_) = false
  -- otherwise

dec $execute(unit, bytes, bytes, predefinedConstants, nat) : outcome
def $execute(UNIT bytes_file n_halt? bytes_auto* (BODY (BODYDECL _ n_flags _ _ _ _ _) (FRAME n _ bytes_cv* _) poolentry* tryregion* _ _ instruction*) _ classDecl*, _, bytes_script, predefinedConstants, n_opline_size)
  = $run($start_symbols({ CODE instruction*, OPLINESIZE n_opline_size, POOL poolentry*, PC 0, SLOTS (($owned(slotValue))* ++ [$owned(NULL)]), ROPEPARTS eps, NEXTARRAY 0, BORROWED eps,
           CELLS eps, ITERATORS eps, FILE bytes_file, SCRIPT bytes_script, LINE 0, NAMES bytes_cv*,
           SYMBOLS ARRAY_VALUE SYMBOL_TABLE eps (STORAGE (-9223372036854775808) (MIXED 64 eps) false) eps, MISSING $(|slotValue*|),
           PREDEFINED predefinedConstants, CONSTANTS $initial_constants(bytes_file, n_halt?), CONSTCACHE eps, STRICT $(n_flags >= 2147483648), TRIES tryregion*, STDOUT eps }, bytes_auto*))
  -- if ~(false <- ($dormant_class(classDecl))*)
  -- if slotValue* = $empty_slots($(|bytes_cv*| + n))
def $execute(_, _, _, _, _) = UNSUPPORTED eps eps
  -- otherwise
