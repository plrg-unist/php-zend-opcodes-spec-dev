zend-opcodes
file "incdec_slots.php"
main
body - {
  lines 1 1
  frame 0 cache 0
  locals 2 ["x", "y"]
  size 13 literals 3 children 0
  lit[0] = int(40)
  lit[1] = "|"
  lit[2] = "\x0a"
  code
    0: ASSIGN CV0, lit[0] | line=1
    1: CV0 = POST_INC CV0 | line=1
    2: ECHO CV0 | line=1
    3: ECHO lit[1] | line=1
    4: CV0 = POST_DEC CV0 | line=1
    5: ECHO CV0 | line=1
    6: ECHO lit[1] | line=1
    7: CV1 = POST_INC CV0 | line=1
    8: ECHO CV1 | line=1
    9: ECHO lit[1] | line=1
    10: ECHO CV0 | line=1
    11: ECHO lit[2] | line=1
    12: RETURN lit[0] | line=1
}
end
