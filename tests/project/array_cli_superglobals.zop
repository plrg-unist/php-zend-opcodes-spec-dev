zend-opcodes
file "cli.php"
main
body - {
  lines 1 1
  frame 1 cache 0
  locals 5 ["_GET", "_POST", "_COOKIE", "_FILES", "_SERVER"]
  size 14 literals 1 children 0
  lit[0] = "\x0a"
  code
    0: T5 = COUNT CV0 | line=1
    1: ECHO T5 | line=1
    2: T5 = COUNT CV1 | line=1
    3: ECHO T5 | line=1
    4: T5 = COUNT CV2 | line=1
    5: ECHO T5 | line=1
    6: T5 = COUNT CV3 | line=1
    7: ECHO T5 | line=1
    8: T5 = GET_TYPE CV4 | line=1
    9: ECHO T5 | line=1
    10: T5 = BOOL CV4 | line=1
    11: ECHO T5 | line=1
    12: ECHO lit[0] | line=1
    13: RETURN lit[0] | line=1
}
end
