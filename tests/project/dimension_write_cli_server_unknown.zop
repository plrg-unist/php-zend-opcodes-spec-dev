zend-opcodes
file "unknown_server_write.php"
main
body - {
  lines 1 1
  frame 1 cache 0
  locals 2 ["_SERVER", "copy"]
  size 8 literals 3 children 0
  lit[0] = "argc"
  lit[1] = int(9)
  lit[2] = "PHP_SPEC_TEST_SERVER_KEY"
  code
    0: ASSIGN CV1, CV0 | line=1
    1: ASSIGN_DIM CV1, lit[0] | line=1
    2: OP_DATA lit[1] | line=1
    3: T2 = FETCH_DIM_R CV1, lit[0] | line=1
    4: ECHO T2 | line=1
    5: T2 = ISSET_ISEMPTY_DIM_OBJ CV1, lit[2] | line=1
    6: ECHO T2 | line=1
    7: RETURN lit[1] | line=1
}
end
