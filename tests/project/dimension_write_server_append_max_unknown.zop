zend-opcodes
file "h"
main
body - {
  lines 1 1
  frame 2 cache 0
  locals 3 ["_SERVER", "s", "r"]
  size 8 literals 3 children 0
  lit[0] = int(9223372036854775806)
  lit[1] = int(1)
  lit[2] = "C"
  code
    0: ASSIGN CV1, CV0 | line=1
    1: ASSIGN_DIM CV1, lit[0] | line=1
    2: OP_DATA lit[1] | line=1
    3: ECHO lit[2] | line=1
    4: ASSIGN_DIM_OP CV1 | line=1 ext=1
    5: OP_DATA CV2 | line=1
    6: ECHO lit[1] | line=1
    7: RETURN lit[1] | line=1
}
end
