zend-opcodes
file "h"
main
body - {
  lines 1 1
  frame 2 cache 0
  locals 3 ["_SERVER", "s", "r"]
  size 6 literals 2 children 0
  lit[0] = int(1)
  lit[1] = "C"
  code
    0: ASSIGN CV1, CV0 | line=1
    1: ECHO lit[1] | line=1
    2: ASSIGN_DIM_OP CV1 | line=1 ext=1
    3: OP_DATA CV2 | line=1
    4: ECHO lit[0] | line=1
    5: RETURN lit[0] | line=1
}
end
