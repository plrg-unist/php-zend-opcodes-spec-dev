zend-opcodes
file "type_check.php"
main
body - {
  lines 1 5
  frame 1 cache 0
  locals 1 ["u"]
  size 11 literals 2 children 0
  lit[0] = ":"
  lit[1] = null
  code
    0: T1 = TYPE_CHECK CV0 | line=1 ext=1
    1: ECHO T1 | line=1
    2: ECHO lit[0] | line=2
    3: T1 = TYPE_CHECK CV0 | line=2
    4: ECHO T1 | line=2
    5: ECHO lit[0] | line=3
    6: T1 = TYPE_CHECK CV0 | line=3 ext=2
    7: ECHO T1 | line=3
    8: T1 = TYPE_CHECK CV0 | line=4 ext=3
    9: ECHO T1 | line=4
    10: RETURN lit[1] | line=5
}
end
