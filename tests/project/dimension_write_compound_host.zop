zend-opcodes
file "compound_host.php"
main
body - {
  lines 1 1
  frame 2 cache 0
  locals 2 ["_SERVER", "array"]
  size 8 literals 4 children 0
  lit[0] = int(0)
  lit[1] = array("PHP_SPEC_TEST_SERVER_KEY" => int(1))
  lit[2] = "H"
  lit[3] = int(1)
  code
    0: T2 = INIT_ARRAY CV0 | line=1 ext=4
    1: ASSIGN CV1, T2 | line=1
    2: ECHO lit[2] | line=1
    3: T2 = ASSIGN_DIM_OP CV1, lit[0] | line=1 ext=1
    4: OP_DATA lit[1] | line=1
    5: T3 = COUNT T2 | line=1
    6: ECHO T3 | line=1
    7: RETURN lit[3] | line=1
}
end
