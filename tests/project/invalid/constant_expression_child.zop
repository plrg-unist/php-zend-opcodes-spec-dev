zend-opcodes
file "missing_child.php"
main
body - {
  lines 1 3
  frame 0 cache 0
  size 3 literals 4 children 0
  lit[0] = "must not print"
  lit[1] = "INVALID"
  lit[2] = ast(binary(1 2 none value(0 2 int(2))))
  lit[3] = int(1)
  code
    0: ECHO lit[0] | line=1
    1: DECLARE_CONST lit[1], lit[2] | line=2
    2: RETURN lit[3] | line=3
}
end
