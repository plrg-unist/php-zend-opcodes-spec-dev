zend-opcodes
file "server_writes.php"
main
body - {
  lines 1 1
  frame 1 cache 0
  locals 2 ["_SERVER", "copy"]
  size 20 literals 6 children 0
  lit[0] = "argc"
  lit[1] = int(9)
  lit[2] = "PHP_SPEC_TEST_SERVER_KEY"
  lit[3] = "X"
  lit[4] = "\x0a"
  lit[5] = int(1)
  code
    0: ASSIGN CV1, CV0 | line=1
    1: ASSIGN_DIM CV1, lit[0] | line=1
    2: OP_DATA lit[1] | line=1
    3: ASSIGN_DIM CV1, lit[2] | line=1
    4: OP_DATA lit[3] | line=1
    5: T2 = FETCH_DIM_R CV1, lit[0] | line=1
    6: ECHO T2 | line=1
    7: T2 = FETCH_DIM_R CV1, lit[2] | line=1
    8: ECHO T2 | line=1
    9: T2 = FETCH_DIM_R CV0, lit[0] | line=1
    10: ECHO T2 | line=1
    11: T2 = BOOL CV1 | line=1
    12: ECHO T2 | line=1
    13: UNSET_DIM CV1, lit[2] | line=1
    14: T2 = ISSET_ISEMPTY_DIM_OBJ CV1, lit[2] | line=1 ext=1
    15: ECHO T2 | line=1
    16: T2 = BOOL CV1 | line=1
    17: ECHO T2 | line=1
    18: ECHO lit[4] | line=1
    19: RETURN lit[5] | line=1
}
end
