zend-opcodes
file "result_slots.php"
main
body - {
  lines 1 1
  frame 1 cache 0
  locals 4 ["array", "first", "second", "argc"]
  size 11 literals 4 children 0
  lit[0] = array(0 => int(0), 1 => int(0))
  lit[1] = int(1)
  lit[2] = "1"
  lit[3] = "\x0a"
  code
    0: ASSIGN CV0, lit[0] | line=1
    1: CV1 = ASSIGN_DIM CV0, lit[1] | line=1 numeric-string-key
    2: OP_DATA CV3 | line=1
    3: CV2 = ASSIGN_DIM_OP CV0, CV3 | line=1 ext=1
    4: OP_DATA CV3 | line=1
    5: ECHO CV1 | line=1
    6: ECHO CV2 | line=1
    7: T4 = FETCH_DIM_R CV0, lit[1] | line=1
    8: ECHO T4 | line=1
    9: ECHO lit[3] | line=1
    10: RETURN lit[1] | line=1
}
end
