zend-opcodes
file "addition_after_echo.php"
main
body - {
  lines 1 1
  frame 1 cache 0
  size 4 literals 3 children 0
  lit[0] = "A\x00\xff"
  lit[1] = int(3)
  lit[2] = int(4)
  code
    0: ECHO lit[0] | line=1
    1: T0 = ADD lit[1], lit[2] | line=1
    2: ECHO T0 | line=1
    3: RETURN lit[1] | line=1
}
end
