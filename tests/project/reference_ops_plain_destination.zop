zend-opcodes
file "reference_ops_plain_destination.php"
main
body - {
  lines 1 1
  frame 2 cache 0
  locals 4 ["x", "y", "z", "w"]
  size 5 literals 2 children 0
  lit[0] = int(7)
  lit[1] = int(2)
  code
    0: ASSIGN CV0, lit[0] | line=1
    1: V4 = ASSIGN CV2, lit[1] | line=1
    2: ECHO lit[0] | line=1
    3: ASSIGN_REF V4, CV0 | line=1
    4: RETURN lit[0] | line=1
}
end
