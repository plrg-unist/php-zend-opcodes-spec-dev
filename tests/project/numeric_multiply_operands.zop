zend-opcodes
file "multiply.php"
main
body - {
  lines 1 2
  frame 2 cache 0
  locals 1 ["n"]
  size 6 literals 3 children 0
  lit[0] = int(5)
  lit[1] = "bad"
  lit[2] = null
  code
    0: V1 = ASSIGN CV0, lit[0] | line=1
    1: T2 = MUL V1, lit[0] | line=1
    2: ECHO T2 | line=1
    3: T2 = MUL CV0, lit[1] | line=2
    4: ECHO T2 | line=2
    5: RETURN lit[2] | line=2
}
end
