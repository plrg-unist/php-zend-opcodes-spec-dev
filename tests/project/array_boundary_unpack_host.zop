zend-opcodes
file "unpack_host.php"
main
body - {
  lines 1 1
  frame 1 cache 0
  locals 1 ["_SERVER"]
  size 6 literals 3 children 0
  lit[0] = "H"
  lit[1] = int(1)
  lit[2] = "done"
  code
    0: ECHO lit[0] | line=1
    1: T1 = INIT_ARRAY | line=1
    2: T1 = ADD_ARRAY_UNPACK CV0 | line=1
    3: FREE T1 | line=1
    4: ECHO lit[2] | line=1
    5: RETURN lit[1] | line=1
}
end
