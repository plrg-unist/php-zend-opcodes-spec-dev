zend-opcodes
file "variable_results.php"
main
body - {
  lines 1 1
  frame 2 cache 0
  locals 1 ["x"]
  size 9 literals 2 children 0
  lit[0] = int(2)
  lit[1] = int(9)
  code
    0: V1 = ASSIGN CV0, lit[0] | line=1
    1: T2 = PRE_INC V1 | line=1
    2: ECHO T2 | line=1
    3: ECHO CV0 | line=1
    4: V1 = ASSIGN CV0, lit[0] | line=1
    5: T2 = ASSIGN V1, lit[1] | line=1
    6: ECHO T2 | line=1
    7: ECHO CV0 | line=1
    8: RETURN lit[0] | line=1
}
end
